---
import '../styles/base.css';
import Masthead from '../components/site/Masthead.astro';
import Footer from '../components/site/Footer.astro';
import { SITE } from '../config/site';
import { graph, orgNode, websiteNode, softwareNode, webPageNode, breadcrumbNode } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  pageType?: string;
  breadcrumbs?: { name: string; path: string }[];
  schema?: unknown[];
  ogImage?: string;
  noindex?: boolean;
  bodyClass?: string;
}
const { title, description, path, pageType, breadcrumbs, schema = [], ogImage = '/og/floorlogic-og.png', noindex = false, bodyClass = '' } = Astro.props;
const canonical = new URL(path, SITE.url).toString();
const og = new URL(ogImage, SITE.url).toString();
const nodes: unknown[] = [
  path === '/' ? orgNode() : null,
  websiteNode(),
  path === '/' || path === '/pricing' ? softwareNode() : null,
  webPageNode({ path, title, description, type: pageType }),
  breadcrumbs ? breadcrumbNode(path, breadcrumbs) : null,
  ...schema,
].filter(Boolean);
// Non-home pages reference the full Organization node by @id only.
if (path !== '/') nodes.unshift({ '@type': 'Organization', '@id': `${SITE.url}/#org`, name: SITE.name, url: SITE.url });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FloorLogic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="preload" href="/fonts/supreme-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={graph(nodes)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <Masthead path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { initSite } from '../lib/site-init';
      initSite();
    </script>
  </body>
</html>
