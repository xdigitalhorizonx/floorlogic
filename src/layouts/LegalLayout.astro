---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; path: string; heading: string; updated: string }
const { title, description, path, heading, updated } = Astro.props;
---
<BaseLayout title={title} description={description} path={path} breadcrumbs={[{ name: 'Home', path: '/' }, { name: heading, path }]}>
  <section class="section band-white legal">
    <div class="container legal-in">
      <p class="eyebrow">Legal</p>
      <h1>{heading}</h1>
      <p class="legal-date">Last updated {updated}</p>
      <div class="legal-body"><slot /></div>
    </div>
  </section>
</BaseLayout>
<style>
  .legal-in { max-width: 760px; }
  .legal h1 { font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.4rem); margin: 14px 0 8px; }
  .legal-date { color: var(--grey-600); font-size: var(--fs-small); }
  .legal-body { margin-top: 28px; color: var(--grey-700); line-height: 1.7; }
  .legal-body :global(h2) { font-size: 1.35rem; margin: 32px 0 10px; }
  .legal-body :global(p + p) { margin-top: 12px; }
  .legal-body :global(ul) { padding-left: 1.2em; margin: 10px 0; }
  .legal-body :global(li + li) { margin-top: 6px; }
</style>
