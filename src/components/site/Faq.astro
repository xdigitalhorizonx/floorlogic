---
import type { Faq } from '../../data/faq';
interface Props { items: Faq[]; title?: string; id?: string; eyebrow?: string }
const { items, title = 'Straight answers', id = 'faq', eyebrow = 'Questions' } = Astro.props;
---
<section class="section band-grey faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="faq-head reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`}>{title}</h2>
    </div>
    <dl class="faq-grid">
      {items.map((f) => (
        <div class="faq-item reveal">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .faq-head { margin-bottom: 32px; max-width: 700px; }
  .faq-head h2 { margin-top: 14px; }
  .faq-grid { margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .faq-item { background: #fff; border-radius: var(--r-card); padding: 22px 24px 24px; box-shadow: 0 0 0 1px rgba(2,49,91,.07), var(--shadow-1); }
  .faq-item dt { font-family: var(--font-display); font-weight: 800; color: var(--navy-900); font-size: 1.12rem; line-height: 1.3; }
  .faq-item dd { margin: 10px 0 0; color: var(--grey-700); line-height: 1.55; }
  @media (max-width: 800px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
