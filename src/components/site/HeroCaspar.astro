  /* ---------------- The replay ----------------
     Without JS, or with reduced motion, none of this applies: the final state shows at once.
     With JS the island sets data-hc (wait → play ⇄ pause → done); until it does, the parts that
     appear during the replay wait hidden, and if the island never runs they show after 4s. */
  @media (prefers-reduced-motion: no-preference) {
    /* Text is never drawn half-transparent, so it never dips under AA contrast, not even mid-move:
       bubbles and the pill pop in from hidden, lines write themselves in left to right. */
    .js .hc-stage:not([data-hc='done']) :is(.hc-msg, .hc-ok)[data-hc-x] { visibility: hidden; transform: translateY(8px) scale(.96); transition: transform .4s var(--ease-out), visibility 0s .4s; }
    .js .hc-stage:not([data-hc='done']) .hc-me[data-hc-x] { transform-origin: 100% 100%; }
    .js .hc-stage:not([data-hc='done']) .hc-cs[data-hc-x] { transform-origin: 0 100%; }
    .js .hc-stage:not([data-hc='done']) .hc-ok[data-hc-x] { transform: scale(.85); transform-origin: 100% 50%; }
    .js .hc-stage:not([data-hc='done']) :is(.hc-msg, .hc-ok)[data-hc-x][data-on] { visibility: visible; transform: none; transition: transform .4s var(--ease-out), visibility 0s; }
    .js .hc-stage:not([data-hc='done']) :is(.hc-ln, .hc-who, .hc-sum, .hc-checked)[data-hc-x] { clip-path: inset(0 100% 0 0); transition: clip-path .5s var(--ease-out); }
    .js .hc-stage:not([data-hc='done']) :is(.hc-ln, .hc-who, .hc-sum, .hc-checked)[data-hc-x][data-on] { clip-path: inset(0 0 0 0); }
    /* What Dale says, live: a deeper blue while he holds the button, each word light blue until it is
       heard, then white; he lets go and the bubble eases to the app's blue. Every step passes AA:
       light blue on the deep blue 4.75:1, white on it 7.4:1, white on the app's blue 4.7:1. */
    .js .hc-stage:not([data-hc='done']) .hc-me[data-on]:not([data-final]) { background-color: #0056a0; }
    .js .hc-stage:not([data-hc='done']) .hc-me[data-hc-x][data-on][data-final] { transition: transform .4s var(--ease-out), visibility 0s, background-color .3s; }
    .js .hc-stage:not([data-hc='done']) .hc-w { color: #b9d2ec; transition: color .16s; }
    .js .hc-stage:not([data-hc='done']) [data-on] .hc-w { color: #fff; transition-delay: calc(120ms + var(--i) * 58ms); }
    .js .hc-stage:not([data-hc='done']) [data-hc-empty] { visibility: visible; }
    .js .hc-stage:not([data-hc='done']) [data-hc-empty][data-off] { visibility: hidden; }
    .js .hc-stage:not([data-hc]) [data-hc-x] { animation: hc-failsafe .01s 4s both; }
    .js .hc-stage:not([data-hc]) .hc-w { animation: hc-failsafe-w .01s 4s both; }
    .js .hc-stage:not([data-hc]) [data-hc-empty] { animation: hc-failsafe-out .01s 4s both; }
    .hc-stage[data-hc='reset'] *, .hc-stage[data-hc='reset'] *::before, .hc-stage[data-hc='reset'] *::after { transition: none !important; }

    /* A line just filled in: a short blue wash, then plain. */
    .hc-stage:not([data-hc='done']) .hc-ln[data-on] { animation: hc-fill .9s var(--ease-out); }
    .hc-stage:not([data-hc='done']) .hc-ok[data-on] { animation: hc-pop .6s var(--ease-out); }
    .hc-stage[data-hc='play'] .hc-wire[data-flow], .hc-stage[data-hc='pause'] .hc-wire[data-flow] { animation: hc-flow .55s linear infinite; }

    /* The orb, as the app draws it: it breathes while it hears, tints while it thinks, pulses while it talks. */
    .hc-stage[data-hc='play'] .hc-phone[data-orb='hear'] .hc-orb, .hc-stage[data-hc='pause'] .hc-phone[data-orb='hear'] .hc-orb { animation: hc-hear 1.3s ease-in-out infinite; }
    .hc-stage[data-hc='play'] .hc-phone[data-orb='talk'] .hc-orb, .hc-stage[data-hc='pause'] .hc-phone[data-orb='talk'] .hc-orb { animation: hc-talk .42s ease-in-out infinite alternate; }
    .hc-phone[data-orb='think'] .hc-orb::after { opacity: 1; }
    .hc-stage[data-hc='play'] .hc-phone[data-orb='think'] .hc-orb, .hc-stage[data-hc='pause'] .hc-phone[data-orb='think'] .hc-orb { animation: hc-think 1s ease-in-out infinite; }
  }
