---
import { TRIAL } from '../../config/site';
interface Props { id: string; source: string; variant?: 'hero' | 'band' | 'page'; dark?: boolean }
const { id, source, variant = 'hero', dark = false } = Astro.props;
---
<form class:list={['tc', `tc--${variant}`, { 'tc--dark': dark }]} data-trial data-source={source} novalidate aria-label="Start a free trial">
  <div class="tc-step1">
    <label for={`${id}-email`} class="sr-only">Work email</label>
    <div class="tc-row">
      <input class="input" id={`${id}-email`} type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@yourshop.com" required aria-describedby={`${id}-hint ${id}-err`} />
      <button class="btn btn-primary" type="submit">Start free trial</button>
    </div>
    <p class="field-error" id={`${id}-err`} data-err hidden></p>
    <p class="tc-micro" id={`${id}-hint`}>{TRIAL.microcopy}</p>
  </div>

  <fieldset class="tc-step2" hidden>
    <legend>Two more things and you're in line</legend>
    <div class="tc-grid">
      <div class="field">
        <label for={`${id}-company`}>Company name</label>
        <input class="input" id={`${id}-company`} name="company_name" autocomplete="organization" required />
      </div>
      <div class="field">
        <label for={`${id}-name`}>Your name</label>
        <input class="input" id={`${id}-name`} name="full_name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for={`${id}-phone`}>Phone <span class="opt">(optional)</span></label>
        <input class="input" id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" />
      </div>
      <div class="field">
        <label for={`${id}-crew`}>Team size <span class="opt">(optional)</span></label>
        <select class="input" id={`${id}-crew`} name="crew_size">
          <option value="">Choose…</option>
          <option>1–3 people</option>
          <option>4–10 people</option>
          <option>11–25 people</option>
          <option>26+ people</option>
        </select>
      </div>
      <div class="field tc-full">
        <label for={`${id}-tool`}>What runs your shop today? <span class="opt">(optional)</span></label>
        <select class="input" id={`${id}-tool`} name="current_tool">
          <option value="">Choose…</option>
          <option>Paper and spreadsheets</option>
          <option>QuickBooks</option>
          <option>FloorZap</option>
          <option>QFloors</option>
          <option>RFMS</option>
          <option>RollMaster</option>
          <option>Jobber or Housecall Pro</option>
          <option>Something else</option>
        </select>
      </div>
    </div>
    <p class="field-error" data-err2 hidden></p>
    <button class="btn btn-primary tc-go" type="submit">Create my free trial</button>
  </fieldset>

  <div class="tc-result" data-result role="status" aria-live="polite" tabindex="-1" hidden></div>
</form>

<style>
  .tc { width: 100%; max-width: 560px; }
  .tc-row { display: flex; gap: 8px; }
  .tc-row .input { flex: 1; min-width: 0; min-height: 54px; font-size: 1.02rem; }
  .tc-row .btn { --bh: 54px; padding: 0 22px; font-size: 1.02rem; }
  .tc-micro { margin-top: 10px; font-size: var(--fs-small); color: var(--grey-600); font-weight: 500; }
  .tc .field-error { margin-top: 8px; }
  .tc-step2 { margin: 18px 0 0; padding: 18px; border: 1px solid var(--grey-200); border-radius: var(--r-card); background: #fff; box-shadow: var(--shadow-2); }
  .tc-step2 legend { font-family: var(--font-display); font-weight: 800; color: var(--navy-900); font-size: 1.05rem; padding: 0 6px; }
  .tc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 4px; }
  .tc-full { grid-column: 1 / -1; }
  .opt { font-weight: 500; color: var(--grey-600); }
  .tc-go { margin-top: 14px; width: 100%; }
  .tc-result { margin-top: 16px; padding: 18px; border-radius: var(--r-card); background: var(--ice-100); border: 1px solid var(--ice-300); color: var(--charcoal); }
  .tc-result:focus { outline: none; }
  .tc--dark .tc-micro { color: #c9d6e6; }
  .tc--dark .tc-step2 legend { color: var(--navy-900); }
  @media (max-width: 520px) {
    .tc-row { flex-direction: column; }
    .tc-row .btn { width: 100%; }
    .tc-grid { grid-template-columns: 1fr; }
  }
</style>
