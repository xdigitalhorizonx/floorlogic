---
import TrialCapture from './TrialCapture.astro';
import { leads, incomingLeads, reps, counters, DEMO_TODAY, demoDate, thread } from '../../data/sample-data';
import {
  BOARD_STATUSES, LEAD_LABELS, LEAD_COLORS, LEAD_AGE_BUCKETS, leadAgeBucketKey, leadAgeBucketDefaultOpen, quoteSentToLead, type Lead,
} from '../../lib/logic/lead-pipeline';
import { fmtMoney } from '../../lib/logic/money';
import { leadCardHTML, bucketHTML, icon } from '../../lib/board/card-html';

const lanes = BOARD_STATUSES;
const QUOTE = thread.quote;
// The board as the app shows it: an approved lead becomes a customer and leaves, and Lost has no
// column. Two touches for the hero (fictional data either way): QT-330 has been emailed, so the
// Prasads sit in Follow-up as the app moves them; Meadowbrook's follow-up is two days late, so the
// app's overdue strip shows.
const onBoard: Lead[] = leads
  .filter((l) => l.status !== 'approved' && l.status !== 'lost')
  .map((l) => {
    if (l.id === thread.lead.id) return quoteSentToLead(l, QUOTE.number, 'email', DEMO_TODAY)?.lead ?? l;
    if (l.number === 'LD-059') return { ...l, followUpDate: demoDate(-2) };
    return l;
  });
const repName = (id: string | null | undefined) => reps.find((r) => r.id === id)?.name ?? '';
const story = {
  leadId: thread.lead.id, quote: QUOTE.number, customer: QUOTE.customerName, total: QUOTE.totals.total,
  wo: thread.workOrder.number, inv: thread.invoice.number, toast: thread.approval.toast,
};
const state = JSON.stringify({ leads: onBoard, incoming: incomingLeads, reps, counters, today: DEMO_TODAY, story });
const laneGroups = (st: (typeof lanes)[number]) => {
  const inLane = onBoard.filter((l) => l.status === st);
  const groups = LEAD_AGE_BUCKETS.map((b) => ({ key: b.key, items: inLane.filter((l) => leadAgeBucketKey(l.createdAt, DEMO_TODAY) === b.key) })).filter((g) => g.items.length);
  const todayCount = groups.find((g) => g.key === 'today')?.items.length ?? 0;
  return { inLane, html: groups.map((g) => bucketHTML(g.key, g.items.map((l) => leadCardHTML(l, repName(l.salesRepId), DEMO_TODAY)).join(''), g.items.length, leadAgeBucketDefaultOpen(g.key, inLane.length, todayCount))).join('') };
};
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">Flooring business software</p>
    <h1 id="hero-title">Every flooring job,<br class="br-d" /> call to paid, <span class="hl">on one board.</span></h1>
    <p class="lead hero-lead">Quote in cartons and roll goods. Your customer approves from their phone. One click turns it into the work order and invoice.</p>
    <TrialCapture id="hero" source="home-hero" />
    <div class="hero-alt">
      <button type="button" class="btn btn-text" data-video-open data-video-at="0"><span class="play" aria-hidden="true"><svg viewBox="0 0 12 12" width="12" height="12"><path d="M3 1.8v8.4L10 6z" fill="currentColor"/></svg></span>Watch the 45-second demo</button>
      <a class="btn btn-text" href="#product">Take the tour <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <aside class="hero-feed" data-feed aria-label="Try the approval">
    <div class="lb-hud">
      <p class="lb-hint" data-hint><span class="lb-hint-dot" aria-hidden="true"></span><span>Sample board. Move a lead, or approve <strong>{QUOTE.number}</strong> as the customer.</span></p>
      <button type="button" class="lb-pause" data-pause aria-pressed="false">Pause</button>
    </div>
    <div class="lb-story" data-story>
      <div class="lb-step" data-step="sent">
        <p class="lb-step-label"><Fragment set:html={icon('mobile')} /> On the customer’s phone</p>
        <div class="lb-step-row">
          <div class="lb-step-q"><strong>{QUOTE.number} · {QUOTE.customerName}</strong><span>Better floor + stairs · {fmtMoney(QUOTE.totals.total)}</span></div>
          <button type="button" class="lb-approve" data-approve>✓ Approve Quote</button>
        </div>
      </div>
      <div class="lb-step" data-step="approved" hidden>
        <p class="lb-step-label"><Fragment set:html={icon('hammer')} /> In the office</p>
        <div class="lb-step-row">
          <div class="lb-step-q"><strong>1 customer-approved quote has no work order or invoice yet.</strong></div>
          <button type="button" class="lb-convert" data-convert><Fragment set:html={icon('hammer')} /> Create WO &amp; Invoice</button>
        </div>
      </div>
      <div class="lb-step" data-step="converted" hidden>
        <p class="lb-step-label"><Fragment set:html={icon('check')} /> Created from {QUOTE.number}</p>
        <div class="lb-docs" data-docs tabindex="-1"></div>
      </div>
    </div>
    <div class="lb-feed" data-toast role="log" aria-live="polite" aria-label="Board activity"></div>
  </aside>

  <div class="lb" data-board role="region" aria-label="Try it: FloorLogic's lead board with sample leads" aria-describedby="lb-help">
    <p id="lb-help" class="sr-only">A working copy of the FloorLogic lead board with fictional sample leads. Pick a site-survey date on a New card, use the green buttons, or focus a card and press the left and right arrow keys to move it. A lead is never moved to Approved by hand: approve its quote on the customer's phone, then press Create WO and Invoice, like the real app.</p>
    <div class="lb-stage" data-stage>
      <div class="lb-pivot" data-pivot>
      <div class="lb-plane" data-plane>
        {lanes.map((st) => {
          const g = laneGroups(st);
          return (
            <div class="lb-lane" data-lane={st} style={`--c:${LEAD_COLORS[st]}`}>
              <div class="lb-head"><span>{LEAD_LABELS[st]}</span><span class="lb-count" data-count>{g.inLane.length}</span></div>
              <div class="lb-cards" data-cards>
                <Fragment set:html={g.html} />
                <p class="lb-empty" data-empty hidden={g.inLane.length > 0}>{st === 'approved' ? 'Reached automatically when one of a lead’s quotes is approved.' : 'No leads — drop here'}</p>
              </div>
            </div>
          );
        })}
      </div>
      </div>
    </div>
    <div class="lb-end" data-end>
      <p><span class="lb-hint-dot" aria-hidden="true"></span><span data-end-msg>Drag a lead, or pick a survey date on a <strong>New</strong> card.</span></p>
      <button type="button" class="lb-pause" data-pause aria-pressed="false">Pause</button>
    </div>
    <div class="lb-confirm" data-confirm role="alertdialog" aria-modal="true" aria-labelledby="lb-confirm-h" aria-describedby="lb-confirm-msg" hidden>
      <h3 id="lb-confirm-h" data-confirm-h></h3>
      <p id="lb-confirm-msg" data-confirm-msg></p>
      <div class="lb-confirm-btns"><button type="button" class="btn btn-ghost" data-confirm-no>Cancel</button><button type="button" class="btn lb-yes" data-confirm-yes>OK</button></div>
    </div>
    <script type="application/json" data-board-state set:html={state}></script>
  </div>
</section>

<script>
  import { initLivingBoard } from '../../islands/living-board';
  initLivingBoard();
</script>

<style is:global>
  /* Owner 2026-10-14: level, symmetric, crisp. Blues centered and a touch stronger. */
  .hero { position: relative; isolation: isolate; overflow: clip; min-height: max(640px, calc(100svh - 72px));
    background: radial-gradient(1500px 640px at 50% 0%, var(--glow), transparent 72%), linear-gradient(180deg, var(--ice-200), var(--ice-100) 48%, var(--ice-50) 82%, var(--white)); }
  /* Background: a bright, empty room with a new plank floor, mirrored so it is exactly symmetric
     (tools/hero-photo). A light-blue wash keeps the copy readable; the board lies on its floor. */
  .hero::before { content: ''; position: absolute; z-index: 0; inset: 0; pointer-events: none;
    --wash: linear-gradient(180deg, rgba(226,237,250,.56) 0%, rgba(231,240,251,.46) 42%, rgba(238,245,253,.5) 72%, rgba(255,255,255,.92) 100%);
    background: var(--wash), url(/img/hero-room-2400.webp) 50% 0 / cover no-repeat;
    background-image: var(--wash), image-set(url(/img/hero-room-2400.webp) 1x, url(/img/hero-room-3144.webp) 2x); }
  @media (min-width: 1921px) { .hero::before { background-image: var(--wash), url(/img/hero-room-3144.webp); } }
  @media (max-width: 899px) {
    .hero::before { inset: 0 0 auto 0; height: 720px;
      --wash: linear-gradient(180deg, rgba(226,237,250,.66) 0%, rgba(233,241,251,.6) 50%, rgba(240,246,253,.66) 100%);
      background-image: var(--wash), url(/img/hero-room-m.webp);
      -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent); mask-image: linear-gradient(180deg, #000 72%, transparent); }
  }
  .hero-copy { position: relative; z-index: 3; width: min(100% - 2 * var(--gutter), 1240px); margin-inline: auto; padding-top: clamp(24px, 4.5vh, 56px); }
  @media (min-width: 1024px) { .hero-copy > :not(h1):not(.eyebrow) { max-width: min(640px, calc(100% - 400px)); } }
  @media (max-width: 1023px) {
    .hero { display: flex; flex-direction: column; }
    .hero-copy { padding-right: 0; order: 1; }
    .lb { order: 2; }
    .hero-feed { position: static; order: 3; width: min(100% - 2 * var(--gutter), 720px); margin: 16px auto 24px; }
  }
  .hero-copy h1 { margin-top: 16px; max-width: 24ch; font-size: clamp(2.5rem, 1.25rem + 4vw, 4.9rem); }
  @media (max-width: 899px) { .br-d { display: none; } }
  .hero-copy .hl { color: var(--blue); }
  .hero-lead { margin: 18px 0 26px; max-width: 44ch; }
  .hero-alt { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 10px; margin-left: -4px; }
  .hero-alt .btn-text { font-weight: 700; }
  /* Short laptop screens (768px tall and under): tighter copy so more of the board shows. */
  @media (min-width: 900px) and (max-height: 820px) {
    .hero-copy { padding-top: 18px; }
    .hero-copy h1 { margin-top: 10px; font-size: clamp(2.5rem, 1rem + 3.6vw, 4.1rem); }
    .hero-lead { margin: 12px 0 18px; }
    .hero-alt { margin-top: 2px; }
  }

  /* ---------------- Living board ----------------
     Drawn at the app's real size (lanes 240–280px, like the app). Narrow screens shrink it with
     CSS zoom, which re-lays out the text instead of stretching pixels. On desktop it starts laid
     back like a floor and pivots up flat as you scroll (symmetric, never scaled above 1). */
  .lb { position: relative; z-index: 2; height: var(--lb-h, 520px); margin-top: clamp(20px, 3.5vh, 44px); clip-path: inset(-300vh -50vw 0 -50vw); }
  .lb::after { content: ''; position: absolute; z-index: 4; left: 0; right: 0; bottom: 0; height: clamp(56px, 10vh, 112px); pointer-events: none; background: linear-gradient(180deg, rgba(255,255,255,0), var(--white)); }
  .lb-stage { position: absolute; inset: 0; display: flex; justify-content: center; align-items: flex-start; }
  /* Desktop scroll pivot hinges on the board's bottom edge: the far edge leans away, nothing ever
     comes closer than true size, so no part is ever drawn bigger than its pixels (no blur). */
  .lb-pivot { flex: none; transform-origin: 50% 100%; }
  .lb-plane { --z: 1; zoom: var(--z); flex: none; position: relative; width: var(--pw, min(1476px, calc(100vw - 2 * var(--gutter))));
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; padding: 14px;
    background: var(--app-bg); border-radius: 16px;
    box-shadow: 0 0 0 1px rgba(2,49,91,.08), 0 2px 6px rgba(2,49,91,.05), 0 44px 90px -40px rgba(2,49,91,.42); }
  .lb-lane { background: #f3f4f6; border-radius: 12px; display: flex; flex-direction: column; min-height: 680px; transition: background .15s, box-shadow .15s; }
  .lb-lane.is-over { background: #eaf2fd; box-shadow: inset 0 0 0 2px var(--c); }
  .lb-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-radius: 12px 12px 0 0; background: var(--c); color: #fff;
    font: 600 13px/1.2 var(--font-app); text-transform: uppercase; letter-spacing: .3px; }
  .lb-count { font-size: 11px; background: rgba(255,255,255,.28); padding: 1px 8px; border-radius: 10px; font-weight: 700; }
  .lb-cards { padding: 8px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .kb-bucket { display: flex; flex-direction: column; gap: 6px; margin-bottom: 4px; }
  .kb-bucket-h { display: flex; align-items: center; gap: 6px; width: 100%; padding: 6px 8px; border: 0; border-radius: 4px; background: rgba(0,0,0,.04); color: #6b7280; font: 700 10px/1.2 var(--font-app); text-transform: uppercase; letter-spacing: .04em; cursor: pointer; text-align: left; }
  .kb-bucket-h:hover { background: rgba(0,0,0,.08); color: #111827; }
  .kb-bucket-h .lf-icon { flex: none; }
  .kb-bucket-arrow { display: inline-flex; width: 10px; font-size: 10px; }
  .kb-bucket-count { margin-left: auto; background: rgba(0,0,0,.08); color: #6b7280; padding: 1px 7px; border-radius: 9px; font-size: 10px; font-weight: 700; }
  .kb-bucket-cards { display: flex; flex-direction: column; gap: 8px; }
  .kb-bucket.is-closed .kb-bucket-cards { display: none; }
  .lb-empty { margin: 4px 2px; padding: 18px 10px; text-align: center; font: 500 12px/1.45 var(--font-app); color: #6b7280; }
  .lb-lane[data-lane='approved'] .lb-empty { border: 1px dashed #c9d2dc; border-radius: 10px; }

  /* The app's card: Inter, white, 8px radius, the app's own shadow and hover */
  .kc { position: relative; background: #fff; border-radius: 8px; padding: 11px 12px 10px; display: flex; flex-direction: column; gap: 7px; font-family: var(--font-app); color: #111827;
    box-shadow: 0 1px 2px rgba(15,23,42,.06), 0 0 0 1px rgba(15,23,42,.05), 0 6px 14px -10px rgba(2,49,91,.3);
    border-left: 3px solid transparent; cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none; transition: box-shadow .15s; }
  .kc:hover { box-shadow: 0 4px 12px rgba(15,23,42,.10), 0 0 0 1px rgba(15,23,42,.08); }
  .kc:focus-visible { outline: 3px solid var(--dot); outline-offset: 2px; }
  .kc.is-lifted { visibility: hidden; }
  .kc-edge-red { border-left: 4px solid #ef4444; }
  .kc-edge-amber { border-left: 4px solid #f59e0b; }
  .kc-urgency { display: flex; gap: 4px; flex-wrap: wrap; }
  .kc-name-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .kc-name { font-weight: 700; font-size: 14px; line-height: 1.3; flex: 1; min-width: 0; }
  .kc-age { font-size: 10.5px; color: #6b7280; font-weight: 600; padding-top: 2px; font-variant-numeric: tabular-nums; }
  .kc-sep { color: #e5e7eb; font-weight: 700; }
  .kc-chips { display: flex; gap: 4px; }
  .kc-pill { display: inline-flex; align-items: center; gap: 3px; padding: 2px 8px; border-radius: 20px; font: 600 10.5px/1.5 var(--font-app); text-transform: uppercase; letter-spacing: .3px; }
  .kc-pill-indigo { background: rgba(99,102,241,.1); color: #4f46e5; }
  .kc-pill-purple { background: rgba(139,92,246,.12); color: #6d28d9; }
  .kc-pill-red { background: rgba(239,68,68,.1); color: #c81e1e; }
  .kc-pill-green { background: rgba(16,185,129,.12); color: #047857; }
  .kc-pill-amber { background: rgba(245,158,11,.14); color: #92400e; }
  .kc-meta { display: flex; flex-direction: column; gap: 2px; }
  .kc-line { font-size: 11.5px; line-height: 1.35; }
  .kc-muted { color: #6b7280; font-size: 11px; }
  .kc .lf-icon { flex: none; width: 1.05em; height: 1.05em; vertical-align: -0.16em; }
  .kc-line, .kc-pill { display: inline-flex; align-items: center; gap: 5px; }
  .kc-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
  .kc-dot-green { background: #10b981; } .kc-dot-amber { background: #f59e0b; } .kc-dot-red { background: #ef4444; }
  .kc-actions { display: flex; gap: 6px; align-items: center; padding-top: 8px; border-top: 1px solid #e5e7eb; }
  .kc-spacer { flex: 1; }
  .kc-adv { flex: 1; display: inline-flex; align-items: center; gap: 6px; border: 0; cursor: pointer; border-radius: 8px; padding: 6px 10px; font: 600 12.5px/1.2 var(--font-app); text-align: left; }
  .kc-adv { background: linear-gradient(180deg, #059669, #047857); color: #fff; box-shadow: 0 1px 2px rgba(4,120,87,.3); }
  .kc-adv:hover { background: #065f46; }
  .kc-survey { flex: 1; min-width: 0; display: flex; align-items: center; gap: 6px; background: rgba(37,99,235,.08); border: 1px solid rgba(37,99,235,.25); border-radius: 6px; padding: 3px 8px; color: #1d4ed8; font: 600 11px/1.2 var(--font-app); cursor: pointer; }
  .kc-survey input { flex: 1; min-width: 0; border: 0; background: #fff; border-radius: 4px; padding: 3px 6px; font: 500 11.5px/1.2 var(--font-app); color: #111827; cursor: pointer; }
  .kc-survey input:focus-visible { outline: 2px solid var(--dot); outline-offset: 1px; }
  .kc-ic { flex: none; width: 30px; height: 28px; display: grid; place-items: center; font-size: 14px; border-radius: 8px; border: 1px solid #e5e7eb; background: #fff; color: #374151; }
  .kc-ic-primary { background: #2563eb; border-color: #2563eb; color: #fff; }

  /* Lifted card (dragging): level, full size, follows the pointer */
  .lb-ghost { position: fixed; z-index: 80; pointer-events: none; width: var(--gw, 260px); transform-origin: 50% 50%; box-shadow: 0 30px 60px -20px rgba(2,49,91,.45), 0 0 0 1px rgba(2,49,91,.08) !important; cursor: grabbing; }

  .hero-feed { display: grid; gap: 10px; }
  @media (min-width: 1024px) { .hero-feed { position: absolute; z-index: 4; top: var(--feed-top, 330px); right: max(var(--gutter), calc((100vw - 1240px) / 2)); width: 340px; } }
  .lb-hud { display: flex; gap: 8px; align-items: center; justify-content: space-between; }
  .lb-hint { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,.94); border: 1px solid var(--grey-200); border-radius: 10px; padding: 9px 12px; font-size: .9rem; font-weight: 600; color: var(--navy-900); box-shadow: var(--shadow-1); line-height: 1.35; }
  .lb-hint strong { color: #047857; }
  .lb-hint a { font-weight: 700; }
  .lb-hint-dot { flex: none; width: 9px; height: 9px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 4px rgba(16,185,129,.18); }
  .lb-pause { flex: none; min-height: 40px; border-radius: 10px; border: 1px solid var(--grey-200); background: rgba(255,255,255,.94); padding: 0 12px; font-weight: 700; color: var(--grey-700); cursor: pointer; box-shadow: var(--shadow-1); }
  .lb-pause[aria-pressed='true'] { color: var(--blue-ink); }
  .lb-feed { display: grid; gap: 8px; }
  .lb-feed p { background: #111827; color: #fff; font: 500 13px/1.4 var(--font-app); padding: 10px 14px; border-radius: 10px; box-shadow: 0 14px 30px -14px rgba(0,0,0,.45); }
  .lb-feed p:not(:first-child) { display: none; }
  .lb-feed p.is-warn { background: #fffbeb; color: #92400e; box-shadow: 0 0 0 1px #fcd34d, 0 14px 30px -14px rgba(146,64,14,.35); }
  .lb-story { background: #fff; border-radius: 12px; padding: 10px 12px 12px; box-shadow: 0 0 0 1px rgba(2,49,91,.1), 0 16px 34px -18px rgba(2,49,91,.45); font-family: var(--font-app); }
  .lb-step[hidden] { display: none; }
  .lb-step-label { display: flex; align-items: center; gap: 6px; font: 700 10px/1.2 var(--font-app); letter-spacing: .06em; text-transform: uppercase; color: #6b7280; }
  .lb-step-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 8px; }
  .lb-step-q { display: grid; gap: 2px; min-width: 0; }
  .lb-step-q strong { font-size: 13px; line-height: 1.35; color: #111827; }
  .lb-step[data-step='sent'] .lb-step-q strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lb-step[data-step='approved'] .lb-step-row { flex-direction: column; align-items: flex-start; gap: 10px; }
  .lb-step[data-step='approved'] .lb-step-q strong { color: #7f1d1d; font-weight: 600; }
  .lb-step-q span { font-size: 12px; color: #4b5563; font-variant-numeric: tabular-nums; }
  .lb-approve, .lb-convert { flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 40px; border: 0; border-radius: 8px; padding: 0 14px; background: linear-gradient(135deg, #047857, #065f46); color: #fff; font: 700 13px/1 var(--font-app); letter-spacing: .01em; cursor: pointer; box-shadow: 0 4px 12px rgba(16,185,129,.3); white-space: nowrap; }
  .lb-approve:hover, .lb-convert:hover { background: #065f46; }
  .lb-approve:focus-visible, .lb-convert:focus-visible { outline: 3px solid var(--dot); outline-offset: 2px; }
  .lb-docs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
  .lb-doc { background: #f8fafc; border-radius: 8px; padding: 10px 11px; font-family: var(--font-app); box-shadow: 0 0 0 1px rgba(2,49,91,.1); }
  .lb-doc-top { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
  .lb-doc .kc-pill { font-size: 9.5px; padding: 2px 7px; white-space: nowrap; }
  @media (min-width: 1024px) { .lb-doc-line { display: none; } }
  .lb-doc-num { font: 700 13px/1 var(--font-app); color: #111827; white-space: nowrap; }
  .lb-doc-line { margin-top: 6px; font-size: 11.5px; color: #4b5563; }

  .lb-end { position: absolute; z-index: 5; left: 0; right: 0; bottom: 22px; width: max-content; margin-inline: auto; display: none; gap: 8px; align-items: center; }
  .lb-end p { display: flex; align-items: center; gap: 10px; margin: 0; background: rgba(255,255,255,.96); border: 1px solid var(--grey-200); border-radius: 999px; padding: 10px 16px; font-weight: 600; color: var(--navy-900); box-shadow: var(--shadow-2); white-space: nowrap; }
  .lb-end strong { color: #047857; }
