---
import '../../styles/app-ui.css';
import TrialCapture from './TrialCapture.astro';
import { DEMO_TODAY, thread } from '../../data/sample-data';
import { heroState } from '../../data/hero-leads';
import { DEFAULT_LIST_FILTER, filterLeads, listCtx, pickSelected } from '../../lib/logic';
import { fmtMoney } from '../../lib/logic/money';
import { filtersHTML, panelHTML, quickAddHTML, stageCardsHTML, statsHTML, tableHTML } from '../../lib/board/list-html';
import { lu, phoneListHTML, phoneSegsHTML } from '../../lib/board/phone-html';
import { icon } from '../../lib/board/card-html';

const QUOTE = thread.quote;
// The Leads screen as it opens: List View, every lead, newest first, the top lead in the panel.
const st = DEFAULT_LIST_FILTER;
const ctx = listCtx(DEMO_TODAY, heroState.reps, heroState.quotes);
const filtered = filterLeads(heroState.leads, st, ctx);
const sel = pickSelected(filtered, null);
const story = {
  leadId: thread.lead.id, quote: QUOTE.number, quoteId: QUOTE.id, customer: QUOTE.customerName, total: QUOTE.totals.total,
  wo: thread.workOrder.number, inv: thread.invoice.number, toast: thread.approval.toast,
  // The dataset's IN-330 (made the day the Prasads approve), so the hero, the modules and the video
  // all show the same due date.
  due: thread.invoice.dueDate,
};
// Only what the screen reads (the island fills in the rest): keeps the page light.
const slim = heroState.leads.map(({ id, number, name, phone, email, address, type, projectType, source, status, salesRepId, siteSurveyDate, followUpDate, createdAt, stageChangedAt, notes }) =>
  ({ id, number, name, phone, email, address, type, projectType, source, status, salesRepId, siteSurveyDate, followUpDate, createdAt, stageChangedAt, notes }));
const state = JSON.stringify({ ...heroState, leads: slim, story });
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">Flooring business software</p>
    <h1 id="hero-title">Every flooring job,<br class="br-d" /> call to paid, <span class="hl">on one board.</span></h1>
    <p class="lead hero-lead">Quote in cartons and roll goods. Your customer approves from their phone. One click turns it into the work order and invoice.</p>
    <TrialCapture id="hero" source="home-hero" />
    <div class="hero-alt">
      <button type="button" class="btn btn-text" data-video-open data-video-at="0"><span class="play" aria-hidden="true"><svg viewBox="0 0 12 12" width="12" height="12"><path d="M3 1.8v8.4L10 6z" fill="currentColor"/></svg></span>Watch the 45-second demo</button>
      <a class="btn btn-text" href="#product">Take the tour <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <aside class="hero-feed" data-feed aria-label="Try the approval">
    <div class="lb-hud">
      <p class="lb-hint" data-hint><span class="lb-hint-dot" aria-hidden="true"></span><span>Sample leads. Add one, or approve <strong>{QUOTE.number}</strong> as the customer.</span></p>
      <button type="button" class="lb-pause" data-pause aria-pressed="false">Pause</button>
    </div>
    <div class="lb-story" data-story>
      <div class="lb-step" data-step="sent">
        <p class="lb-step-label"><Fragment set:html={icon('mobile')} /> On the customer’s phone</p>
        <div class="lb-step-row">
          <div class="lb-step-q"><strong>{QUOTE.number} · {QUOTE.customerName}</strong><span>Better floor + stairs · {fmtMoney(QUOTE.totals.total)}</span></div>
          <button type="button" class="lb-approve" data-approve>✓ Approve Quote</button>
        </div>
      </div>
      <div class="lb-step" data-step="approved" hidden>
        <p class="lb-step-label"><Fragment set:html={icon('hammer')} /> In the office</p>
        <div class="lb-step-row">
          <div class="lb-step-q"><strong>1 customer-approved quote has no work order or invoice yet.</strong></div>
          <button type="button" class="lb-convert" data-convert><Fragment set:html={icon('hammer')} /> Create WO &amp; Invoice</button>
        </div>
      </div>
      <div class="lb-step" data-step="converted" hidden>
        <p class="lb-step-label"><Fragment set:html={icon('check')} /> Created from {QUOTE.number}</p>
        <div class="lb-docs" data-docs tabindex="-1"></div>
      </div>
    </div>
    <div class="lb-feed" data-feedlog role="log" aria-label="On the customer’s phone"></div>
  </aside>

  <div class="lb" data-board role="region" aria-label="Try it: FloorLogic’s Lead Pipeline with sample leads" aria-describedby="lb-help">
    <p id="lb-help" class="sr-only">A working copy of the FloorLogic Leads screen with fictional sample leads. Add a lead in the quick add bar, pick a lead in the list to work it in the panel, set a site-survey date or a follow-up date, add a note, or approve QT-330 on the customer’s phone and then create the work order and invoice, like the real app. Nothing is saved or sent.</p>
    <div class="lb-stage" data-stage>
      <div class="lb-pivot" data-pivot>
        <div class="lb-plane lc-page" data-plane>
          <div class="lc-header">
            <div class="lc-title"><h2 class="lc-h1">Lead Pipeline</h2><div class="lc-stats" data-stats><Fragment set:html={statsHTML(heroState.leads, DEMO_TODAY)} /></div></div>
          </div>
          <div class="lc-card lc-quick"><Fragment set:html={quickAddHTML(heroState.reps)} /></div>
          <div class="lc-grid">
            <div class="lc-card lc-list" data-list>
              <div class="lc-list-top">
                <div class="lc-search"><span class="lc-search-ico" aria-hidden="true"><Fragment set:html={icon('search')} /></span><input type="text" id="lead-search-input" data-search placeholder="Search leads — name, phone, email, address, notes" aria-label="Search leads" title="↑ / ↓ move through the list" autocomplete="off" /></div>
                <span class="lc-count" data-count title="Shown / total"><b>{filtered.length}</b>/{heroState.leads.length}<span class="sr-only"> leads shown</span></span>
              </div>
              <div class="lc-filters" data-filters><Fragment set:html={filtersHTML(heroState.leads, st, heroState.reps)} /></div>
              <div class="lc-table-wrap" data-table><Fragment set:html={tableHTML(filtered, st, sel?.id ?? null, ctx)} /></div>
            </div>
            <div class="lc-card lc-panel-card"><div class="lc-panel" id="lc-panel" data-lc-panel role="region" aria-label="Selected lead" data-lead={sel?.id ?? ''}><Fragment set:html={panelHTML(sel, ctx)} /></div></div>
          </div>
          <div class="lc-stages" data-stages><Fragment set:html={stageCardsHTML(heroState.leads, st, DEMO_TODAY)} /></div>
          <div class="lc-toasts" data-toasts aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <div class="hm" data-phone>
      <div class="hm-screen" data-m-screen>
        <div class="hm-scr" data-m-list-scr>
          <div class="hm-top"><h2 class="m-big">Leads</h2><button type="button" class="m-icbtn" data-act="m-new" aria-label="New lead"><Fragment set:html={lu('user-plus')} /></button></div>
          <div class="m-sticky">
            <label class="m-search"><Fragment set:html={lu('search')} /><span class="sr-only">Search leads</span><input id="m-lead-q" type="search" enterkeyhint="search" autocomplete="off" placeholder="Search leads" data-m-q /></label>
            <div class="m-segs" role="group" aria-label="Show" data-m-segs><Fragment set:html={phoneSegsHTML(heroState.leads, 'active')} /></div>
          </div>
          <div class="m-list" id="m-lead-list" data-m-list><Fragment set:html={phoneListHTML(heroState.leads, 'active', '', DEMO_TODAY)} /></div>
        </div>
        <div class="hm-scr" data-m-lead-scr hidden>
          <div class="hm-bar"><button type="button" class="m-icbtn m-back" data-act="m-back" aria-label="Back to Leads"><Fragment set:html={lu('chevron-left')} /></button><span class="hm-bar-t">Leads</span></div>
          <div data-m-lead></div>
        </div>
      </div>
      <dialog class="m-sheet" data-m-sheet aria-labelledby="m-sheet-h">
        <div class="m-grab" aria-hidden="true"></div>
        <header class="m-sh-hd"><h2 id="m-sheet-h" data-m-sheet-h></h2><button type="button" class="m-icbtn" data-act="m-close" aria-label="Close"><Fragment set:html={lu('x')} /></button></header>
        <div class="m-sh-body" data-m-sheet-body></div>
      </dialog>
      <div class="hm-toast" data-m-toast aria-hidden="true"></div>
    </div>

    <div class="lb-end" data-end>
      <p><span class="lb-hint-dot" aria-hidden="true"></span><span>Add a lead, or set a survey date on a <strong>New</strong> lead.</span></p>
      <button type="button" class="lb-pause" data-pause aria-pressed="false">Pause</button>
    </div>
    <dialog class="a-modal app lb-dlg" data-dlg aria-labelledby="lb-dlg-h" aria-describedby="lb-dlg-b">
      <div class="a-dlg">
        <div class="a-dlg-h" data-dlg-head><h4 id="lb-dlg-h" data-dlg-h></h4><button type="button" class="a-x" data-dlg-x aria-label="Close">✕</button></div>
        <div class="a-dlg-b" id="lb-dlg-b" data-dlg-b></div>
        <div class="a-dlg-f" data-dlg-f></div>
      </div>
    </dialog>
    <p class="sr-only" data-live aria-live="polite"></p>
    <script type="application/json" data-board-state set:html={state}></script>
  </div>
</section>

<script>
  import { initLivingBoard } from '../../islands/living-board';
  initLivingBoard();
</script>

<style is:global>
  /* Owner 2026-10-14: level, symmetric, crisp. Blues centered and a touch stronger. */
  .hero { position: relative; isolation: isolate; overflow: clip; min-height: max(640px, calc(100svh - 72px));
    background: radial-gradient(1500px 640px at 50% 0%, var(--glow), transparent 72%), linear-gradient(180deg, var(--ice-200), var(--ice-100) 48%, var(--ice-50) 82%, var(--white)); }
  /* Background: a bright, empty room with a new plank floor, mirrored so it is exactly symmetric
     (tools/hero-photo). A light-blue wash keeps the copy readable; the screen lies on its floor. */
  .hero::before { content: ''; position: absolute; z-index: 0; inset: 0; pointer-events: none;
    --wash: linear-gradient(180deg, rgba(226,237,250,.56) 0%, rgba(231,240,251,.46) 42%, rgba(238,245,253,.5) 72%, rgba(255,255,255,.92) 100%);
    background: var(--wash), url(/img/hero-room-2400.webp) 50% 0 / cover no-repeat;
    background-image: var(--wash), image-set(url(/img/hero-room-2400.webp) 1x, url(/img/hero-room-3144.webp) 2x); }
  @media (min-width: 1921px) { .hero::before { background-image: var(--wash), url(/img/hero-room-3144.webp); } }
  @media (max-width: 899px) {
    .hero::before { inset: 0 0 auto 0; height: 720px;
      --wash: linear-gradient(180deg, rgba(226,237,250,.66) 0%, rgba(233,241,251,.6) 50%, rgba(240,246,253,.66) 100%);
      background-image: var(--wash), url(/img/hero-room-m.webp);
      -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent); mask-image: linear-gradient(180deg, #000 72%, transparent); }
  }
  .hero-copy { position: relative; z-index: 3; width: min(100% - 2 * var(--gutter), 1240px); margin-inline: auto; padding-top: clamp(24px, 4.5vh, 56px); }
  @media (min-width: 1024px) { .hero-copy > :not(h1):not(.eyebrow) { max-width: min(640px, calc(100% - 400px)); } }
  @media (max-width: 1023px) {
    .hero { display: flex; flex-direction: column; }
    .hero-copy { padding-right: 0; order: 1; }
    .lb { order: 2; }
    .hero-feed { position: static; order: 3; width: min(100% - 2 * var(--gutter), 720px); margin: 16px auto 24px; }
  }
  .hero-copy h1 { margin-top: 16px; max-width: 24ch; font-size: clamp(2.5rem, 1.25rem + 4vw, 4.9rem); }
  @media (max-width: 899px) { .br-d { display: none; } }
  .hero-copy .hl { color: var(--blue); }
  .hero-lead { margin: 18px 0 26px; max-width: 44ch; }
  .hero-alt { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 10px; margin-left: -4px; }
  .hero-alt .btn-text { font-weight: 700; }
  /* Short laptop screens (820px tall and under): tighter copy so more of the screen shows. */
  @media (min-width: 900px) and (max-height: 820px) {
    .hero-copy { padding-top: 18px; }
    .hero-copy h1 { margin-top: 10px; font-size: clamp(2.5rem, 1rem + 3.6vw, 4.1rem); }
    .hero-lead { margin: 12px 0 18px; }
    .hero-alt { margin-top: 2px; }
  }

  /* ---------------- The Leads screen ----------------
     The app's List View at its real size (Inter, the app's tokens). Narrow desktops shrink it with
     CSS zoom, which re-lays out the text instead of stretching pixels; it is never drawn bigger
     than 1. On desktop it starts laid back like a floor and pivots up flat as you scroll. */
  .lb { position: relative; z-index: 2; height: var(--lb-h, 560px); margin-top: clamp(20px, 3.5vh, 44px); clip-path: inset(-300vh -50vw 0 -50vw); }
  .lb::after { content: ''; position: absolute; z-index: 4; left: 0; right: 0; bottom: 0; height: clamp(56px, 10vh, 112px); pointer-events: none; opacity: var(--fade, 1); background: linear-gradient(180deg, rgba(255,255,255,0), var(--white)); }
  .lb.is-flat { height: auto; clip-path: none; padding-bottom: 32px; }
  .lb.is-flat::after { display: none; }
  .lb-stage { position: absolute; inset: 0; display: flex; justify-content: center; align-items: flex-start; }
  .lb.is-flat .lb-stage { position: relative; inset: auto; }
  /* The scroll pivot hinges on the screen's bottom edge: the far edge leans away, nothing ever comes
     closer than true size, so nothing is ever drawn bigger than its pixels (no blur). */
  .lb-pivot { flex: none; transform-origin: 50% 100%; }
  .lb-plane { --z: 1; zoom: var(--z); flex: none; position: relative; width: var(--pw, min(1480px, calc(100vw - 2 * var(--gutter)))); border-radius: 16px;
    box-shadow: 0 0 0 1px rgba(2,49,91,.08), 0 2px 6px rgba(2,49,91,.05), 0 44px 90px -40px rgba(2,49,91,.42); }
  /* While the screen is tilted or moving, its list and panel do not scroll, so the wheel scrolls the page. */
  .lb.is-tilted .lc-table-wrap, .lb.is-tilted .lc-panel { overflow: hidden; }

  /* The app's tokens (main :root, light). Text colours that miss WCAG AA on the app's tints use the
     next darker shade of the same hue (marked AA). */
  .lc-page { --primary: #0074d3; --gray: #5f6672; /* AA (app #6B7280) */ --light: #f3f4f6; --border: #e5e7eb; --text: #111827; --info-bg: #eff6ff; --info-border: #bfdbfe;
    --blue-fg: #005ba8; /* AA on info-bg (app #0074D3) */ --bg-hover: #f3f4f6; --amber-strong: #d97706; --shadow: 0 1px 3px rgba(0,0,0,.1), 0 1px 2px rgba(0,0,0,.06);
    padding: 20px 24px; background: var(--app-bg); color: var(--text); font: 400 14px/1.5 var(--font-app); -webkit-font-smoothing: antialiased; text-align: left; }
  .lc-page *, .lc-page *::before, .lc-page *::after { box-sizing: border-box; }
  .lc-page .lf-icon { display: inline-block; width: 1em; height: 1em; vertical-align: -0.15em; flex: none; }
  /* The app's base controls, kept at element weight so every component class overrides them. */
  :where(.lc-page) button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
  :where(.lc-page) :is(input, select, textarea) { width: 100%; font: inherit; font-size: 14px; color: var(--text); background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; outline: none; transition: border .2s; }
  :where(.lc-page) :is(input, select, textarea):focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
  :where(.lc-page) textarea { resize: vertical; min-height: 80px; }
  .lc-page :focus-visible { outline: 3px solid var(--dot); outline-offset: 2px; }
  .lc-page input:focus-visible, .lc-page select:focus-visible, .lc-page textarea:focus-visible { outline: 2px solid var(--primary); outline-offset: 1px; }
  .lc-muted { color: var(--gray); }
  .lc-bad { color: #dc2626; } .lc-good { color: #047857; } .lc-prim { color: var(--primary); }
  .lc-card { background: #fff; border-radius: 12px; box-shadow: var(--shadow); padding: 20px; }
  .lc-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; font: 500 14px/1.5 var(--font-app); white-space: nowrap; text-decoration: none; transition: background .15s, border-color .15s, color .15s, box-shadow .15s; }
  .lc-page .lc-btn-primary { background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; box-shadow: 0 2px 8px rgba(37,99,235,.3); }
  .lc-page .lc-btn-primary:hover { background: linear-gradient(135deg, #1d4ed8, #1e40af); box-shadow: 0 4px 12px rgba(37,99,235,.4); color: #fff; }
  .lc-page .lc-btn-outline { border: 1px solid var(--border); color: var(--text); background: #fff; }
  .lc-page .lc-btn-outline:hover { border-color: var(--primary); color: var(--primary); }
  .lc-page .lc-btn-sm { padding: 5px 10px; font-size: 12px; }
  .lc-btn.is-press { box-shadow: 0 0 0 3px rgba(37,99,235,.25); }
  /* Badges: uppercase 11px/600 on a 10% tint (blue and amber text one step darker for AA on a selected row). */
  .lc-page .badge-pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; line-height: 1.5; text-transform: uppercase; letter-spacing: .3px; white-space: nowrap; }
  .badge-blue { background: rgba(59,130,246,.1); color: #1d4ed8; }
  .badge-indigo { background: rgba(99,102,241,.1); color: #4f46e5; }
  .badge-amber { background: rgba(245,158,11,.1); color: #92400e; }
  .badge-pink { background: rgba(236,72,153,.1); color: #be185d; }
  .badge-green { background: rgba(16,185,129,.1); color: #047857; }
  .badge-red { background: rgba(239,68,68,.1); color: #b91c1c; }
  .badge-gray { background: rgba(107,114,128,.1); color: #4b5563; }
  .badge-purple { background: rgba(139,92,246,.1); color: #6d28d9; }

  .lc-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .lc-title { min-width: 0; }
  .lc-page .lc-h1 { margin: 0; font: 800 28px/1.5 var(--font-app); letter-spacing: -.3px; color: var(--text); }
  .lc-stats { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 18px; margin-top: 6px; font-size: 12.5px; color: var(--text); }
  .lc-stats b { font-weight: 700; font-variant-numeric: tabular-nums; }
  .lc-page .lc-stat-link { font-size: 12.5px; text-align: left; }
  .lc-stat-link:hover { text-decoration: underline; }

  .lc-quick { padding: 12px 14px; margin-bottom: 16px; }
  .lc-quick-form { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .lc-quick-form .lc-q { flex: 1 1 100px; min-width: 0; width: auto; font-size: 13px; padding: 8px 10px; }
  .lc-quick-form select.lc-q { flex: 0 1 140px; }
  .lc-q-addr { flex: 1.5 1 150px; min-width: 0; }
  .lc-quick-form .lc-q-addr .lc-q { width: 100%; }
  .lc-quick-form .lc-btn { flex: 0 0 auto; }
  .lc-q.is-auto { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37,99,235,.1); }

  /* The list and the panel side by side; the panel takes the list's height and scrolls inside it. */
  .lc-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 14px; align-items: stretch; margin-bottom: 16px; }
  .lc-list { padding: 0; overflow: hidden; display: flex; flex-direction: column; min-width: 0; height: var(--lc-list-h, auto); }
  .lc-panel-card { padding: 0; position: relative; overflow: hidden; min-width: 0; }
  .lc-list-top { display: flex; align-items: center; gap: 12px; padding: 12px 14px 8px; }
  .lc-search { position: relative; flex: 1; min-width: 0; }
  .lc-page .lc-search input { padding: 8px 12px 8px 34px; font-size: 13px; }
  .lc-search-ico { position: absolute; left: 11px; top: 0; bottom: 0; display: flex; align-items: center; color: var(--gray); font-size: 13px; line-height: 1; pointer-events: none; }
  .lc-count { font-size: 13px; color: var(--gray); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .lc-count b { color: var(--text); }
  .lc-filters { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; padding: 0 14px 10px; }
  .lc-page .lf-filter-sel { width: auto; max-width: 180px; font-size: 12px; padding: 6px 10px; cursor: pointer; }
  .lc-page .lf-filter-sel:hover { border-color: var(--primary); }
  .lc-page .lf-filter-sel-active { border-color: var(--primary); color: var(--blue-fg); font-weight: 600; }
  .lc-page .lf-clear-btn { display: inline-flex; align-items: center; gap: 3px; font-size: 11px; padding: 4px 8px; border: 1px solid var(--border); border-radius: 6px; background: #fff; color: var(--gray); font-weight: 600; line-height: 1; }
  .lc-page .lf-clear-btn:hover { border-color: #dc2626; color: #dc2626; }
  .lc-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 11.5px; font-weight: 600; color: var(--blue-fg); background: var(--info-bg); border: 1px solid var(--info-border); border-radius: 12px; padding: 2px 3px 2px 9px; white-space: nowrap; }
  .lc-page .lc-chip button { display: inline-grid; place-items: center; font-size: 10px; padding: 2px 4px; line-height: 1; border-radius: 8px; }
  .lc-chip button:hover { background: var(--info-border); }

  .lc-table-wrap { flex: 1 1 auto; min-height: 0; overflow: auto; border-top: 1px solid var(--border); }
  .lc-table { width: 100%; min-width: 820px; table-layout: fixed; border-collapse: separate; border-spacing: 0; font-size: 12.5px; }
  .lc-table th, .lc-table td { overflow: hidden; text-overflow: ellipsis; }
  .lc-table th { position: sticky; top: 0; z-index: 2; background: #fff; padding: 8px 5px; text-align: left; font-size: 10px; font-weight: 700; color: var(--gray); text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .lc-table th button { display: inline-flex; align-items: center; max-width: 100%; text-align: inherit; text-transform: inherit; letter-spacing: inherit; font-weight: inherit; white-space: inherit; line-height: inherit; }
  .lc-table th button:hover { color: var(--text); }
  .lc-table th.lc-th-wrap { white-space: normal; line-height: 1.25; }
  .lc-sort { display: inline-flex; opacity: .3; font-size: 9px; margin-left: 4px; }
  .lc-sort.on { opacity: 1; color: var(--primary); }
  .lc-table td { padding: 6px 5px; border-bottom: 1px solid var(--border); white-space: nowrap; vertical-align: middle; color: var(--text); }
  .lc-table th:first-child, .lc-table td:first-child { padding-left: 12px; }
  .lc-table .lc-num { text-align: right; }
  .lc-table th.lc-num button { justify-content: flex-end; }
  /* Right-aligned headers ("Quoted ⇅") may run into the next cell's padding rather than lose a letter. */
  .lc-table th.lc-num { overflow: visible; text-overflow: clip; }
  .lc-table th:last-child, .lc-table td:last-child { padding-right: 8px; }
  .lc-row { cursor: pointer; }
  .lc-row:hover td { background: var(--bg-hover); }
  .lc-row.lc-row-sel td { background: var(--info-bg); }
  .lc-row.lc-row-sel td:first-child { box-shadow: inset 3px 0 0 var(--primary); }
  .lc-row.is-new td { animation: lc-new 1.6s ease-out; }
  @keyframes lc-new { from { background: #dbeafe; } }
  .lc-page .lc-namecell { display: flex; align-items: center; gap: 8px; width: 100%; min-width: 0; text-align: left; }
  .lc-nm { display: block; min-width: 0; }
  .lc-nm1 { display: block; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lc-nm2 { display: block; font-size: 10.5px; color: var(--gray); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; margin-top: 1px; }
  .lc-clip { overflow: hidden; text-overflow: ellipsis; }
  .lc-sub { font-size: 11px; color: var(--gray); overflow: hidden; text-overflow: ellipsis; margin-top: 1px; }
  .lc-page .lc-table .badge-pill { font-size: 9.5px; padding: 2px 7px; letter-spacing: 0; }
  .lc-table .lc-av { width: 28px; height: 28px; font-size: 10.5px; }
  .lc-fu { position: relative; display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 6px; vertical-align: 1px; }
  .lc-fu-overdue { background: #ef4444; } .lc-fu-today { background: #f59e0b; } .lc-fu-soon { background: #10b981; }
  .lc-stale { display: inline-flex; color: var(--amber-strong); margin-left: 5px; font-size: 12px; vertical-align: -1px; cursor: help; }
  .lc-table-empty { padding: 44px 20px; text-align: center; color: var(--gray); }
  .lc-table-empty .icon { font-size: 30px; margin-bottom: 6px; color: var(--gray); }
  .lc-table-empty h3 { margin: 0 0 4px; font: 600 15px/1.4 var(--font-app); color: var(--text); letter-spacing: 0; }
  .lc-table-empty p { font-size: 13px; margin-bottom: 12px; }
  .lc-av { width: 30px; height: 30px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 11px; font-weight: 700; letter-spacing: .02em; background: var(--info-bg); color: var(--blue-fg); border: 1px solid var(--info-border); }
  .lc-av.biz { background: rgba(99,102,241,.12); color: #4338ca; border-color: rgba(99,102,241,.32); }
  .lc-av.lg { width: 46px; height: 46px; font-size: 16px; }

  .lc-panel { position: absolute; inset: 0; overflow: auto; overscroll-behavior: contain; }
  .lc-p-head { display: flex; align-items: center; gap: 12px; padding: 16px 16px 8px; }
  .lc-p-title { flex: 1; min-width: 0; }
  .lc-page .lc-p-name { margin: 0; font: 800 17px/1.25 var(--font-app); letter-spacing: 0; color: var(--text); word-break: break-word; }
  .lc-p-sub { font-size: 12px; color: var(--gray); margin-top: 2px; }
  .lc-p-stage { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; padding: 0 16px 8px; font-size: 12px; }
  .lc-p-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; padding: 0 16px 10px; font-size: 13px; }
  .lc-p-contact > span:not(.lc-muted) { word-break: break-all; }
  .lc-p-actions { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 16px 14px; }
  .lc-sec { padding: 12px 16px; border-top: 1px solid var(--border); }
  .lc-page .lc-sec-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 0 0 8px; font: 700 10.5px/1.5 var(--font-app); letter-spacing: .07em; text-transform: uppercase; color: var(--gray); }
  .lc-sec-n { display: inline-block; margin-left: 4px; padding: 0 6px; border-radius: 9px; background: var(--light); color: var(--text); font-size: 10.5px; letter-spacing: 0; }
  /* Rows 8px apart (app 6px) so each chip keeps a 24px tap circle even while the screen is still laid back. */
  .lc-stage-btns { display: flex; flex-wrap: wrap; gap: 8px 6px; }
  .lc-page .lc-stage-btn { font-size: 12px; font-weight: 600; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--border); background: #fff; color: var(--text); line-height: 1.5; transition: border-color .12s, background .12s; }
  .lc-stage-btn::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--c); margin-right: 6px; vertical-align: 1px; }
  .lc-page .lc-stage-btn:hover { border-color: var(--c); }
  .lc-page .lc-stage-btn.on { border-color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent); box-shadow: inset 0 0 0 1px var(--c); cursor: default; }
  .lc-stage-btn.lc-stage-auto { display: inline-block; border-style: dashed; color: var(--gray); cursor: help; }
  .lc-stage-btn.lc-stage-auto:hover { border-color: var(--border); }
  .lc-stage-btn.lc-stage-auto.on { border-style: solid; color: var(--text); }
  .lc-dates { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }
  .lc-date { display: flex; flex-direction: column; gap: 3px; font-size: 11px; font-weight: 600; color: var(--gray); }
  .lc-page .lc-date input { font-size: 12.5px; padding: 6px 8px; font-weight: 400; }
  .lc-date input.is-auto { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37,99,235,.15); }
  .lc-page .lc-note-in { min-height: 60px; font-size: 13px; resize: vertical; }
  .lc-note-btns { display: flex; justify-content: flex-end; margin: 6px 0 4px; }
  .lc-note { padding: 8px 0; border-bottom: 1px dashed var(--border); }
  .lc-note:last-child { border-bottom: none; }
  .lc-note-d { font-size: 10.5px; font-weight: 600; color: var(--gray); margin-bottom: 2px; }
  .lc-note-t { font-size: 13px; white-space: pre-wrap; word-break: break-word; color: var(--text); }
  .lc-empty { font-size: 12.5px; color: var(--gray); font-style: italic; padding: 2px 0; }
  .lc-dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 12px; font-size: 12.5px; margin: 0; }
  .lc-dl dt { color: var(--gray); }
  .lc-dl dd { margin: 0; color: var(--text); word-break: break-word; min-width: 0; }
  .lc-qrow { display: flex; align-items: center; gap: 8px; width: 100%; padding: 6px 8px; border-radius: 6px; font-size: 12.5px; color: var(--text); }
  .lc-q-n { font-weight: 700; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .lc-q-t { margin-left: auto; font-weight: 600; font-variant-numeric: tabular-nums; }
  .lc-page .lc-qrow .badge-pill { font-size: 10px; padding: 1px 8px; }
  .lc-p-empty { padding: 56px 24px; text-align: center; color: var(--gray); }
  .lc-p-empty .icon { font-size: 30px; margin-bottom: 6px; }
  .lc-p-empty h3 { margin: 0 0 4px; font: 600 15px/1.4 var(--font-app); color: var(--text); letter-spacing: 0; }
  .lc-p-empty p { font-size: 13px; }

  .lc-stages { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .lc-stage-card { padding: 12px 12px 10px; border-top: 3px solid var(--c); min-height: 120px; }
  .lc-stage-h { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; padding: 2px 2px 4px; font-size: 13px; font-weight: 700; color: var(--text); }
  .lc-stage-h::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--c); flex-shrink: 0; }
  .lc-stage-n { margin-left: auto; font-size: 12px; font-weight: 700; color: var(--gray); background: var(--light); padding: 1px 8px; border-radius: 10px; font-variant-numeric: tabular-nums; }
  .lc-page .lc-bucket { display: flex; align-items: center; gap: 8px; width: 100%; padding: 6px 8px; border-radius: 6px; font-size: 12.5px; color: var(--text); text-align: left; }
  .lc-page .lc-bucket:hover { background: var(--bg-hover); }
  .lc-page .lc-bucket.on { background: var(--info-bg); color: var(--blue-fg); font-weight: 600; }
  .lc-bucket .n { margin-left: auto; font-weight: 700; font-variant-numeric: tabular-nums; }
  .lc-bucket .chev { color: var(--gray); font-size: 14px; line-height: 1; }

  /* The app's toast (showToast): white, blurred, a coloured 4px edge, top right of the screen. */
  .lc-toasts { position: absolute; top: 14px; right: 16px; z-index: 20; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; pointer-events: none; }
  .lc-toast { display: flex; align-items: center; gap: 10px; max-width: 360px; padding: 12px 20px; border: 1px solid rgba(0,0,0,.06); border-left: 4px solid #10b981; border-radius: 12px; background: rgba(255,255,255,.95);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: 0 10px 40px rgba(0,0,0,.12); font: 500 13px/1.4 var(--font-app); color: #111827; }
  .lc-toast[data-type='warning'] { border-left-color: #f59e0b; }
  .lc-toast[data-type='info'] { border-left-color: #0074d3; }

  /* ---------------- The feed beside the copy: the customer's phone, then the office ---------------- */
  .hero-feed { display: grid; gap: 10px; }
  @media (min-width: 1024px) { .hero-feed { position: absolute; z-index: 4; top: var(--feed-top, 330px); right: max(var(--gutter), calc((100vw - 1240px) / 2)); width: 340px; } }
  .lb-hud { display: flex; gap: 8px; align-items: center; justify-content: space-between; }
  .lb-hint { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,.94); border: 1px solid var(--grey-200); border-radius: 10px; padding: 9px 12px; font-size: .9rem; font-weight: 600; color: var(--navy-900); box-shadow: var(--shadow-1); line-height: 1.35; text-wrap: pretty; }
  .lb-hint strong { color: #047857; white-space: nowrap; }
  .lb-hint a { font-weight: 700; }
  .lb-hint-dot { flex: none; width: 9px; height: 9px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 4px rgba(16,185,129,.18); }
  /* One width for "Pause" and "Play", so the hint beside it never reflows when it is pressed. */
  .lb-pause { flex: none; min-height: 40px; min-width: 74px; border-radius: 10px; border: 1px solid var(--grey-200); background: rgba(255,255,255,.94); padding: 0 12px; font-weight: 700; color: var(--grey-700); cursor: pointer; box-shadow: var(--shadow-1); }
  .lb-pause[aria-pressed='true'] { color: var(--blue-ink); }
  .lb-feed { display: grid; gap: 8px; }
  .lb-feed p { background: #111827; color: #fff; font: 500 13px/1.4 var(--font-app); padding: 10px 14px; border-radius: 10px; box-shadow: 0 14px 30px -14px rgba(0,0,0,.45); }
  .lb-feed p:not(:first-child) { display: none; }
  .lb-story { background: #fff; border-radius: 12px; padding: 10px 12px 12px; box-shadow: 0 0 0 1px rgba(2,49,91,.1), 0 16px 34px -18px rgba(2,49,91,.45); font-family: var(--font-app); }
  .lb-step[hidden] { display: none; }
  .lb-step-label { display: flex; align-items: center; gap: 6px; font: 700 10px/1.2 var(--font-app); letter-spacing: .06em; text-transform: uppercase; color: #5f6672; }
  .lb-step-label .lf-icon, .lb-convert .lf-icon { display: inline-block; width: 1.05em; height: 1.05em; flex: none; }
  .lb-step-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 8px; }
  .lb-step-q { display: grid; gap: 2px; min-width: 0; }
  .lb-step-q strong { font-size: 13px; line-height: 1.35; color: #111827; }
  .lb-step[data-step='sent'] .lb-step-q strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lb-step[data-step='approved'] .lb-step-row { flex-direction: column; align-items: flex-start; gap: 10px; }
  .lb-step[data-step='approved'] .lb-step-q strong { color: #7f1d1d; font-weight: 600; }
  .lb-step-q span { font-size: 12px; color: #4b5563; font-variant-numeric: tabular-nums; }
  .lb-approve, .lb-convert { flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 40px; border: 0; border-radius: 8px; padding: 0 14px; background: linear-gradient(135deg, #047857, #065f46); color: #fff; font: 700 13px/1 var(--font-app); letter-spacing: .01em; cursor: pointer; box-shadow: 0 4px 12px rgba(16,185,129,.3); white-space: nowrap; }
  .lb-approve:hover, .lb-convert:hover { background: #065f46; }
  .lb-approve:focus-visible, .lb-convert:focus-visible { outline: 3px solid var(--dot); outline-offset: 2px; }
  .lb-docs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
  .lb-doc { background: #f8fafc; border-radius: 8px; padding: 10px 11px; font-family: var(--font-app); box-shadow: 0 0 0 1px rgba(2,49,91,.1); }
  .lb-doc-top { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
  .lb-doc .kc-pill { display: inline-flex; align-items: center; padding: 2px 7px; border-radius: 20px; font: 600 9.5px/1.5 var(--font-app); text-transform: uppercase; letter-spacing: .3px; white-space: nowrap; }
  .kc-pill-purple { background: rgba(139,92,246,.12); color: #6d28d9; }
  .kc-pill-red { background: rgba(239,68,68,.1); color: #b91c1c; }
  @media (min-width: 1024px) { .lb-doc-line { display: none; } }
  .lb-doc-num { font: 700 13px/1 var(--font-app); color: #111827; white-space: nowrap; }
  .lb-doc-line { margin-top: 6px; font-size: 11.5px; color: #4b5563; }

  .lb-end { position: absolute; z-index: 5; left: 0; right: 0; bottom: 22px; width: max-content; margin-inline: auto; display: none; gap: 8px; align-items: center; }
  .lb-end p { display: flex; align-items: center; gap: 10px; margin: 0; background: rgba(255,255,255,.96); border: 1px solid var(--grey-200); border-radius: 999px; padding: 10px 16px; font-weight: 600; color: var(--navy-900); box-shadow: var(--shadow-2); white-space: nowrap; }
  .lb-end strong { color: #047857; }
  .lb-end.is-docked { top: var(--end-top); bottom: auto; }
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) { .js .lb-end { display: flex; visibility: hidden; opacity: 0; } }
  .lb-dlg { --dlg-w: 460px; }
  .lb-dlg .a-dlg-b p + p { margin-top: 8px; }
  .lb-dlg-dups { display: grid; gap: 8px; }
  .lb-dlg-dup { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border: 1px solid var(--app-border); border-radius: 8px; }
  .lb-dlg-dup > div { flex: 1; min-width: 0; }
  .lb-dlg-dup strong { font-size: 13.5px; }
  .lb-dlg-dup small { display: block; margin-top: 2px; font-size: 11.5px; color: #5f6672; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lb-dlg-why { margin-left: 8px; font-size: 11px; font-weight: 600; color: #b91c1c; }
  .lb-dlg-kind { margin-left: 8px; font-size: 10px; font-weight: 700; background: #e5e7eb; color: #374151; padding: 1px 7px; border-radius: 8px; }

  /* ---------------- Phones: the app's own phone version (/mobile) ---------------- */
  .hm { display: none; }
  @media (max-width: 899px) {
    .hero { min-height: 0; padding-bottom: 28px; }
    .hero-copy h1 { max-width: 16ch; }
    /* Above the copy (they never overlap here), so the phone app's toast, fixed under the masthead, shows over the copy too. */
    .lb { height: auto; margin-top: 28px; clip-path: none; z-index: 4; }
    .lb::after, .lb-stage { display: none; }
    .hm { display: block; width: min(100% - 2 * var(--gutter), 560px); margin-inline: auto; }
  }
  /* On a phone the phone app is (nearly) the full width, as it is on a real phone. */
  @media (max-width: 520px) { .hm { width: calc(100% - 16px); } }
  .hm { --m-bg: #f3f5f9; --m-card: #fff; --m-card-2: #f7f8fb; --m-ink: #0f172a; --m-sub: #5b6577; --m-faint: #667085; /* AA (app #8a93a3) */
    --m-line: #e3e7ee; --m-brand: #0074d3; --m-brand-soft: #e6f1fb; --m-shadow: 0 1px 2px rgba(15,23,42,.06), 0 6px 20px rgba(15,23,42,.06);
    --m-green: #15803d; --m-green-soft: #e8f6ee; --m-red: #c02626; --m-red-soft: #fdecec; --m-amber: #b45309; --m-amber-soft: #fdf3e2;
    --m-blue: #1d64d8; --m-blue-soft: #e7effd; --m-indigo: #4f46e5; --m-indigo-soft: #eceafd; --m-pink: #be185d; --m-pink-soft: #fceaf3;
    --m-gray: #4b5563; --m-gray-soft: #eef0f3; --m-teal: #0f766e; --m-teal-soft: #e3f5f2; --m-r: 16px;
    font: 400 15px/1.4 var(--font-app); color: var(--m-ink); -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
  .hm *, .hm *::before, .hm *::after { box-sizing: border-box; }
  .hm-screen { background: var(--m-bg); border-radius: 22px; padding: 6px 16px 20px; box-shadow: 0 0 0 1px rgba(2,49,91,.08), 0 30px 50px -30px rgba(2,49,91,.35); }
  .hm-scr[hidden] { display: none; }
  .m-ic { display: block; width: 20px; height: 20px; flex-shrink: 0; }
  .hm-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .hm .m-big { margin: 10px 2px 12px; font: 800 32px/1.1 var(--font-app); letter-spacing: -.02em; color: var(--m-ink); }
  .m-icbtn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 12px; border: 0; background: transparent; color: var(--m-brand); cursor: pointer; padding: 0; }
  .m-icbtn:active { background: var(--m-brand-soft); }
  .m-icbtn .m-ic { width: 22px; height: 22px; }
  .hm-bar { display: flex; align-items: center; gap: 2px; height: 52px; margin: 0 -8px; }
  .m-back .m-ic { width: 26px; height: 26px; }
  .hm-bar-t { font-weight: 600; font-size: 16px; color: var(--m-brand); }
  .m-sticky { padding: 2px 0 10px; }
  .m-search { display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 12px; border-radius: 12px; background: var(--m-card); border: 1px solid var(--m-line); color: var(--m-faint); }
  .m-search .m-ic { width: 18px; height: 18px; }
  .m-search input { flex: 1; min-width: 0; height: 100%; padding: 0; border: 0; outline: 0; background: transparent; color: var(--m-ink); font: 16px/1 var(--font-app); }
  .m-search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .m-search:focus-within { border-color: var(--m-brand); box-shadow: 0 0 0 3px var(--m-brand-soft); }
  .m-segs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin: 10px -16px 0; padding: 0 16px; }
  .m-segs::-webkit-scrollbar { display: none; }
  .m-seg { flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; border-radius: 18px; border: 1px solid var(--m-line); background: var(--m-card); color: var(--m-sub); font: 600 14px/1 var(--font-app); cursor: pointer; }
  .m-seg i { font-style: normal; font-size: 12px; color: var(--m-faint); font-variant-numeric: tabular-nums; }
  .m-seg.on { background: var(--m-ink); border-color: var(--m-ink); color: var(--m-bg); }
  .m-seg.on i { color: inherit; opacity: .8; }
  .m-list { display: flex; flex-direction: column; gap: 8px; }
  .m-row { display: flex; align-items: stretch; background: var(--m-card); border-radius: var(--m-r); box-shadow: var(--m-shadow); overflow: hidden; }
  .m-row-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12px; border: 0; background: none; color: inherit; text-align: left; padding: 12px 12px 12px 14px; cursor: pointer; }
  .m-row-main:active { background: var(--m-card-2); }
  .m-row.is-new { animation: m-new 1.6s ease-out; }
  @keyframes m-new { from { box-shadow: 0 0 0 2px var(--m-brand), var(--m-shadow); } }
  .m-row-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .m-row-txt b { display: flex; align-items: center; gap: 6px; font-size: 15.5px; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* The app's own rule puts the ellipsis on a flex box, where it never shows (the name is just cut off);
     on the site the name sits in its own span so a long one ends in "…". */
  .m-row-txt b .m-row-n { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .m-row-txt b em { font-style: normal; font-size: 11px; font-weight: 700; color: var(--m-sub); background: var(--m-gray-soft); border-radius: 6px; padding: 2px 6px; }
  .m-row-txt small { font-size: 13px; color: var(--m-sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hm .m-stale { display: inline-flex; color: #ea580c; background: none; padding: 0; }
  .m-stale .m-ic { width: 15px; height: 15px; }
  .m-av { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; font: 700 14px/1 var(--font-app); letter-spacing: .02em; }
