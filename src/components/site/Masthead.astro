---
import { NAV, TRIAL } from '../../config/site';
interface Props { path: string }
const { path } = Astro.props;
---
<header class="mast" data-mast>
  <div class="mast-in">
    <a class="mast-logo" href="/" aria-label="FloorLogic home">
      <img src="/brand/floorlogic-lockup-horizontal.svg" alt="FloorLogic" width="229" height="40" />
    </a>
    <nav class="mast-nav" aria-label="Main">
      {NAV.map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <form class="mast-trial" data-mast-trial novalidate aria-label="Start a free trial">
      <label for="mast-email" class="sr-only">Work email</label>
      <input id="mast-email" class="input" type="email" name="email" autocomplete="email" placeholder="you@yourshop.com" required />
      <button class="btn btn-primary" type="submit">Start free trial</button>
    </form>
    <a class="btn btn-primary mast-cta-sm" href="/start"><span class="cta-long">Start free trial</span><span class="cta-short">Free trial</span></a>
    <button class="mast-burger" type="button" aria-expanded="false" aria-controls="mast-menu" data-burger>
      <span class="sr-only">Menu</span>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <div class="mast-menu" id="mast-menu" hidden>
    <nav aria-label="Mobile">
      {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/start" class="btn btn-primary">Start free trial</a>
      <p class="mast-menu-note">{TRIAL.microcopy}</p>
    </nav>
  </div>
</header>

<style>
  .mast { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.86); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid transparent; transition: border-color .2s, box-shadow .2s; }
  .mast.is-stuck { border-bottom-color: var(--grey-200); box-shadow: 0 6px 24px -18px rgba(2,49,91,.4); }
  .mast-in { display: flex; align-items: center; gap: clamp(12px, 2vw, 28px); height: 72px; width: min(100% - 2 * var(--gutter), 1360px); margin-inline: auto; }
  .mast-logo { flex: none; display: block; }
  .mast-logo img { height: 40px; width: auto; }
  .mast-nav { display: flex; gap: 4px; }
  .mast-nav a { color: var(--grey-700); text-decoration: none; font-weight: 600; font-size: .98rem; padding: 10px 12px; border-radius: var(--r-ui); }
  .mast-nav a:hover, .mast-nav a[aria-current='page'] { color: var(--navy-900); background: var(--ice-100); }
  .mast-trial { margin-left: auto; display: flex; gap: 8px; }
  .mast-trial .input { width: 230px; min-height: 44px; }
  .mast-trial .btn { --bh: 44px; }
  .mast-cta-sm, .mast-burger { display: none; }
  .mast-burger { margin-left: 4px; width: 44px; height: 44px; border-radius: var(--r-ui); border: 1px solid var(--grey-200); background: #fff; color: var(--navy-900); place-items: center; cursor: pointer; }
  .mast-menu { border-top: 1px solid var(--grey-200); background: #fff; }
  .mast-menu nav { display: grid; gap: 4px; padding: 12px var(--gutter) 20px; }
  .mast-menu a:not(.btn) { padding: 12px 4px; font-weight: 700; color: var(--navy-900); text-decoration: none; border-bottom: 1px solid var(--grey-100); }
  .mast-menu .btn { margin-top: 12px; }
  .mast-menu-note { font-size: var(--fs-micro); color: var(--grey-600); text-align: center; margin-top: 8px; }
  @media (max-width: 1180px) { .mast-trial .input { width: 190px; } }
  @media (max-width: 1060px) {
    .mast-trial { display: none; }
    .mast-cta-sm { display: inline-flex; margin-left: auto; --bh: 44px; }
  }
  @media (max-width: 820px) {
    .mast-nav { display: none; }
    .mast-burger { display: grid; }
    .mast-in { height: 64px; }
    .mast-logo img { height: 34px; }
  }
  .cta-short { display: none; }
  @media (max-width: 420px) { .mast-cta-sm { padding: 0 14px; font-size: .95rem; } .mast-logo img { height: 28px; } .cta-long { display: none; } .cta-short { display: inline; } .mast-in { gap: 10px; } }
</style>
