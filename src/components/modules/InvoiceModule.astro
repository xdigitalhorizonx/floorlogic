---
/**
 * "Get paid" — IN-330 in today's invoice screen (renderInvoiceBuilder, main L18331): the header's
 * 💰 Take Payment / ✅ Paid in Full, ☐ Final Invoice and Balance Due; the paper's Bill To (Tax Rate +
 * Payment Terms), Invoice Number / Issued / Due Date, the sections, the totals and the 💳 Payment
 * Schedule; the 💳 Payments card — beside the customer's live invoice (q.html) and its PAYMENT card.
 * Server-renders the starting picture; the island (src/islands/invoice-terms.ts) drives it with
 * due-now.ts. Sample data only (src/data/modules/invoice.ts ← src/data/sample-data.ts); no network.
 */
import { invoiceData as d } from '../../data/modules/invoice';
import { fmtDate, taxRatePill } from '../../lib/logic';
import {
  ivmInitialState, ivmUpfront, ivmClockText, ivmPillClass, ivmStatus, ivmStatusLabel, renderIvmAct, renderIvmBal, renderIvmTotals,
  renderIvmPays, renderIvmPhone, renderIvmSection, renderIvmPSection, IVM_MAX_AGE,
} from '../../islands/invoice-terms';
import { appRailHtml, withAppIcons } from '../../data/modules/app-icons';

const s = ivmInitialState(d);
const st = ivmStatus(d, s);
const json = JSON.stringify(d).replace(/</g, '\\u003c');
const taxPct = taxRatePill(d.taxRate, false);
---
<article class="mod ivm" aria-labelledby="ivm-title" data-ivm>
  <header class="mod-head">
    <div><span class="mod-kicker">Get paid</span><h3 id="ivm-title">Paid on your terms.</h3></div>
    <p class="mod-task" data-task>Try it: switch the terms, then record a check.</p>
  </header>

  <div class="mod-ctl ivm-clock">
    <label class="ivm-clock-l" for="ivm-age"><span aria-hidden="true">📅</span> Demo clock</label>
    <input class="ivm-clock-r" type="range" id="ivm-age" min="0" max={IVM_MAX_AGE} step="1" value={s.age} data-ivm-age aria-describedby="ivm-age-hint" aria-valuetext={ivmClockText(d, s)} />
    <output class="ivm-clock-o" for="ivm-age" data-ivm-clock>{ivmClockText(d, s)}</output>
    <small class="ivm-clock-h" id="ivm-age-hint">Drag to age the invoice and watch Net terms come due.</small>
  </div>

  <div class="ivm-stage">
    <!-- ================= The office: the invoice screen ================= -->
    <div class="ivm-b">
      <div class="app ivm-app" role="region" aria-label={`FloorLogic invoice ${d.number} (sample data)`}>
        <div class="app-frame ivm-frame">
          <div class="app-rail" aria-hidden="true" set:html={appRailHtml('invoices')} />
          <div class="app-main">
            <div class="app-top ivm-top">
              <div class="ivm-top-main">
                <div class="ivm-top-l">
                  <span class="ivm-top-title" set:html={withAppIcons('🧾 Invoice')} />
                  <span class="ivm-top-num">{d.number}</span>
                  <span class={ivmPillClass(st)} data-ivm-pill>{ivmStatusLabel(st)}</span>
                </div>
                <div class="ivm-top-meta">
                  <span class="ivm-cust" title={d.customer}><span class="ivm-cust-av" aria-hidden="true">{d.initials}</span><span class="ivm-cust-name">{d.customer}</span><span class="ivm-ctag">Customer</span></span>
                  <span class="ivm-act" data-ivm-act set:html={withAppIcons(renderIvmAct(d, s))} />
                </div>
              </div>
              <div class="ivm-top-r">
                <button type="button" class="ivm-final" data-ivm-final aria-pressed="false" title="When active, the live invoice asks the customer for 100% of the remaining balance instead of just the deposit">☐ Final Invoice</button>
                <div class="ivm-hbal" data-ivm-bal set:html={renderIvmBal(d, s)} />
              </div>
            </div>
            <div class="a-tdock"><div class="a-toast ivm-toast" data-ivm-toast aria-hidden="true"></div></div>

            <div class="app-body ivm-body" data-ivm-body>
              <div class="ivm-paper">
                <div class="ivm-info">
                  <div class="ivm-box">
                    <div class="ivm-box-h">Bill To</div>
                    <div class="ivm-box-b">
                      <div class="ivm-bill-name">{d.customer}</div>
                      <div class="ivm-bill-line"><b>Address:</b> {d.city}</div>
                      <div class="ivm-bill-line"><b>Phone:</b> {d.phone}</div>
                      {d.email && <div class="ivm-bill-line"><b>Email:</b> {d.email}</div>}
                      <div class="ivm-taxrow">
                        <div><div class="ivm-lbl">Tax Rate</div><div class="ivm-pillbox"><strong>{taxPct}</strong><small>{d.taxCounty}</small></div></div>
                        <div>
                          <label class="ivm-lbl" for="ivm-terms">Payment Terms</label>
                          <select class="ivm-terms" id="ivm-terms" data-ivm-terms>
                            <option value="">— Select —</option>
                            {d.termsOptions.map((t) => <option value={t} selected={t === s.terms}>{t}</option>)}
                          </select>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="ivm-qn">
                    <div class="ivm-qn-box"><div class="ivm-qn-h">Invoice Number</div><div class="ivm-qn-n">{d.number}</div></div>
                    <dl class="ivm-qn-meta">
                      <dt>Issued</dt><dd>{fmtDate(d.createdAt)}</dd>
                      <dt>Due Date</dt><dd>{fmtDate(d.dueDate)}</dd>
                      <dt>Sales Rep</dt><dd>{d.rep.name}</dd>
                      <dt>Sales Rep 2</dt><dd>— None —</dd>
                    </dl>
                  </div>
                </div>

                {d.sections.map((_, i) => (
                  <section class="ivm-sec" aria-labelledby={`ivm-sec-t-${i}`} set:html={withAppIcons(renderIvmSection(d, i))} />
                ))}

                <div class="ivm-bottom">
                  <table class="ivm-tot" aria-label={`Invoice ${d.number} totals`}><tbody data-ivm-totals set:html={renderIvmTotals(d, s)} /></table>
                  <div class="ivm-sched">
                    <div class="ivm-sched-h" set:html={withAppIcons('💳 Payment Schedule')} />
                    <div class="ivm-sched-b">
                      <label class="ivm-sched-l" for="ivm-pct">Down Payment:</label>
                      <input class="ivm-pct num" id="ivm-pct" type="number" min="0" max="100" step="1" inputmode="numeric" value={s.pct} data-ivm-pct />
                      <span class="ivm-sched-pc" aria-hidden="true">%</span>
                      <span class="ivm-upfront num" data-ivm-upfront>{ivmUpfront(d, s)}</span>
                    </div>
                  </div>
                </div>
                <div class="ivm-foot">{d.shop.name} | {d.shop.address}, {d.shop.city} | {d.shop.phone}<em>Thank you for choosing {d.shop.name}!</em></div>
              </div>

              <section class="app-card ivm-pays" aria-labelledby="ivm-pays-h" data-ivm-pays set:html={withAppIcons(renderIvmPays(d, s))} />
            </div>
          </div>
        </div>
        <dialog class="a-modal" data-ivm-dlg></dialog>
      </div>
    </div>

    <!-- ================= The customer's phone: the live invoice (q.html?inv=1) ================= -->
    <div class="ivm-p">
      <p class="ivm-pcap" data-ivm-livecap><span class="ivm-livedot" aria-hidden="true"></span>Live invoice · what {d.customer} see</p>
      <div class="ivm-phone">
        <div class="ivm-screen" data-ivm-pscreen>
          <div class="ivm-island" aria-hidden="true"></div>
          <div class="ivm-status" aria-hidden="true">
            <span>9:41</span>
            <span class="ivm-status-ic">
              <svg viewBox="0 0 18 12" width="18" height="12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5.5" width="3" height="6.5" rx="1"/><rect x="10" y="3" width="3" height="9" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1"/></svg>
              <svg viewBox="0 0 24 24" width="16" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.86a10 10 0 0 1 14 0"/><path d="M8.5 16.43a5 5 0 0 1 7 0"/></svg>
              <svg viewBox="0 0 27 13" width="25" height="12"><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" fill="none" stroke="currentColor" stroke-opacity=".4"/><rect x="2.5" y="2.5" width="19" height="8" rx="2" fill="currentColor"/><path d="M25 4.5v4a2 2 0 0 0 0-4z" fill="currentColor" fill-opacity=".45"/></svg>
            </span>
          </div>
          <div class="ivm-pscroll" data-ivm-pscroll role="region" aria-label={`The customer's phone: live invoice ${d.number}`} tabindex="0">
            <div class="ivm-q">
              <div class="ivm-q-wrap">
                <div class="ivm-q-paper">
                  <div class="ivm-q-header">
                    <div class="ivm-q-top">
                      <div class="ivm-q-logo">
                        <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true"><rect x="18.2" y="25" width="3.6" height="9" rx="1.4" fill="#7a5a3a"/><path d="M20 3.5c5.4 4.8 10.2 9.6 10.2 15.3 0 4-2.9 6.7-6.6 6.7h-7.2c-3.7 0-6.6-2.7-6.6-6.7C9.8 13.1 14.6 8.3 20 3.5z" fill="#3f6b4f"/><path d="M20 12.2c3.9 3.4 7 6.6 7 10.3 0 2.6-1.9 4.3-4.3 4.3h-5.4c-2.4 0-4.3-1.7-4.3-4.3 0-3.7 3.1-6.9 7-10.3z" fill="#5a8a68"/><path d="M5 36.5h30" stroke="#c4a87c" stroke-width="2.2" stroke-linecap="round"/></svg>
                        <span class="ivm-q-logo-t"><b>Pinyon</b><small>Flooring Co.</small></span>
                      </div>
                      <div class="ivm-q-topr">
                        <div class="ivm-q-qbox"><div class="ivm-q-qbox-h">INVOICE NUMBER</div><div class="ivm-q-qbox-n">{d.number}</div></div>
                        <div class="ivm-q-dates">
                          <div class="ivm-q-rrow"><span class="ivm-q-rlbl">ISSUED</span><span class="ivm-q-rval">{fmtDate(d.createdAt)}</span></div>
                          <div class="ivm-q-rrow"><span class="ivm-q-rlbl">DUE</span><span class="ivm-q-rval">{fmtDate(d.dueDate)}</span></div>
                        </div>
                      </div>
                    </div>
                    <div class="ivm-q-meta">
                      <dl>
                        <dt>ADDRESS</dt><dd>{d.shop.address}<br />{d.shop.city}</dd>
                        <dt>PHONE</dt><dd>{d.shop.phone}</dd>
                        <dt>EMAIL</dt><dd>{d.shop.email}</dd>
                      </dl>
                      <div class="ivm-q-rep"><div class="ivm-q-rep-l">SALES REP</div><div class="ivm-q-rep-n">{d.rep.name}</div><span class="ivm-q-rep-e">{d.rep.email}</span></div>
                    </div>
                  </div>
                  <div class="ivm-q-bs">
                    <div class="ivm-q-box">
                      <div class="ivm-q-box-h">BILL TO</div>
                      <dl>
                        <dt>NAME</dt><dd>{d.customer}</dd>
                        <dt>ADDRESS</dt><dd>{d.city}</dd>
                        <dt>PHONE</dt><dd>{d.phone}</dd>
                        {d.email && <><dt>EMAIL</dt><dd>{d.email}</dd></>}
                      </dl>
                    </div>
                    <div class="ivm-q-box">
                      <div class="ivm-q-box-h">SITE DETAILS</div>
                      <dl>
                        <dt>CONTACT</dt><dd>{d.customer}</dd>
                        <dt>ADDRESS</dt><dd>{d.city}</dd>
                        <dt>PHONE</dt><dd>{d.phone}</dd>
                      </dl>
                    </div>
                  </div>
                  {d.sections.map((_, i) => <div class="ivm-q-sec" set:html={renderIvmPSection(d, i)} />)}
                  <div data-ivm-phone set:html={renderIvmPhone(d, s)} />
                  <div class="ivm-q-footer">{d.shop.name} | {d.shop.address}, {d.shop.city} | {d.shop.phone}<em>Thank you for choosing {d.shop.name}!</em></div>
                </div>
              </div>
            </div>
          </div>
          <div class="ivm-home" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>

  <p class="sr-only" data-ivm-live aria-live="polite"></p>
  <p class="mod-foot">Same rules as the app: what the live invoice asks for follows the payment terms, the deposit % and Final Invoice; Net terms come due by the invoice’s age. Sample invoice for fictional customers — nothing is charged, saved or sent. <button type="button" class="ivm-reset" data-ivm-reset hidden>Start over</button></p>
  <script type="application/json" data-ivm-data set:html={json}></script>
</article>

<script>
  // Hydrate on approach, like the other modules: the island loads when the module nears the
  // viewport (an inactive tab loads when it is first shown). The server-rendered picture stands until then.
  import { whenNear } from '../../lib/when-near';
  whenNear('[data-ivm]', () => import('../../islands/invoice-terms').then((m) => m.initInvoiceModules()));
</script>

<style is:global>
  /* ================= InvoiceModule (.ivm-) — DOM is patched by script, so global + prefixed ================= */
  .ivm { --ivm-primary: #0074d3; --ivm-green: #047857; }
  .ivm [hidden] { display: none !important; }
  .ivm .mod-head h3 { text-wrap: balance; }
  .ivm .mod-foot { line-height: 1.55; max-width: 92ch; }
  .ivm-mono, .ivm-top-num, .ivm-chk { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }

  /* ---------- Demo clock (a site control, outside the frame) ---------- */
  .ivm-clock { margin-bottom: 16px; }
  .ivm-clock-l { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .ivm-clock-r { flex: 1 1 180px; min-width: 140px; max-width: 360px; margin: 0; accent-color: var(--blue); cursor: pointer; }
  .ivm-clock-o { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ivm-clock-h { flex-basis: 100%; }

  .ivm-stage { display: grid; gap: 28px; align-items: start; }
  @media (min-width: 1100px) {
    .ivm-stage { grid-template-columns: minmax(0, 1fr) minmax(340px, 392px); gap: 32px; }
    .ivm-p { position: sticky; top: var(--app-stick); }
  }
  .ivm-b { position: relative; min-width: 0; }

  /* ---------- Invoice header (main L18378-18389): title + badge, customer + Take Payment; Final Invoice + Balance Due ---------- */
  .ivm .app-top.ivm-top { position: sticky; top: var(--app-stick); z-index: 4; min-height: 60px; padding: 9px 14px; gap: 12px; box-shadow: 0 8px 18px -16px rgba(15,23,42,.45); }
  .ivm-top-main { display: grid; gap: 7px; min-width: 0; flex: 1 1 auto; }
  .ivm-top-l { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .ivm-top-title { display: inline-flex; align-items: center; gap: 5px; font: 800 19px/1.1 var(--font-app); color: var(--ivm-primary); letter-spacing: -.01em; white-space: nowrap; }
  .ivm-top-num { font-size: 13.5px; font-weight: 700; line-height: 1; color: #6b7280; letter-spacing: .04em; }
  .ivm-top-l .a-pill { font-size: 10px; }
  .ivm-top-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 8px; min-width: 0; }
  .ivm-cust { display: inline-flex; align-items: center; gap: 8px; min-width: 0; max-width: 100%; padding: 3px 9px 3px 3px; border: 1px solid var(--app-border); border-radius: 999px; background: #fff; }
  .ivm-cust-av { flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, #2563eb, #1e40af); color: #fff; font: 700 11px/1 var(--font-app); letter-spacing: .02em; }
  .ivm-cust-name { min-width: 0; font: 600 13px/1.25 var(--font-app); color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ivm-ctag { flex: none; padding: 0 6px; border-radius: 8px; background: #b6d7a8; color: #1f2d1a; font-size: 10px; line-height: 1.5; }
  .ivm-act { display: inline-flex; }
  .ivm-take { min-height: 32px; }
  .ivm-paidtext { display: inline-flex; align-items: center; gap: 5px; padding: 4px 8px; border-radius: 6px; color: var(--ivm-green); font: 600 13px/1.3 var(--font-app); }
  .ivm-paidtext:focus { outline: none; }
  .ivm-paidtext:focus-visible { outline: 3px solid var(--dot); outline-offset: 2px; }
  .ivm-top-r { flex: none; margin-left: auto; display: flex; align-items: center; gap: 10px; }
  /* .hdr-final-btn (main L1469): 13px/600 #1e3a8a, radius 8; on = green with a soft glow (the app's #10B981, one step darker for AA) */
  .ivm-final { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 7px 13px; border: 1px solid var(--app-border); border-radius: 8px; background: #fff; color: #1e3a8a; font: 600 13px/1.2 var(--font-app); white-space: nowrap; cursor: pointer; transition: border-color .15s, color .15s, background-color .15s, box-shadow .15s; }
  .ivm-final:hover { border-color: #047857; background: #ecfdf5; color: #047857; }
  .ivm-final.is-final, .ivm-final.is-final:hover { border-color: #047857; background: #047857; color: #fff; box-shadow: 0 2px 8px rgba(16,185,129,.35); }
  /* .hdr-totals-btn (main L1483): Balance Due, red while owed, green otherwise, "of $total" */
  .ivm-hbal { display: inline-flex; flex-direction: column; align-items: flex-end; padding: 5px 12px 6px; border: 1px solid #bfdbfe; border-radius: 12px; background: linear-gradient(135deg, #eff6ff, #f0f9ff); line-height: 1.1; font-family: var(--font-app); }
  .ivm-hbal-cap { font-size: 9.5px; font-weight: 700; line-height: 1.2; text-transform: uppercase; letter-spacing: .06em; color: #1e3a8a; }
  .ivm-hbal-val { margin-top: 1px; font-size: 19px; font-weight: 700; line-height: 1.15; color: var(--ivm-green); }
  .ivm-hbal-val.is-due { color: #dc2626; }
  .ivm-hbal-of { margin-top: 1px; font-size: 10px; color: #6b7280; }
  .ivm .a-tdock { top: calc(var(--app-stick) + var(--ivm-head, 64px)); }
  .ivm .ivm-toast { top: 10px; }
  .ivm .ivm-body { padding: 14px; background: var(--app-bg); display: grid; gap: 14px; align-content: start; }

  /* ---------- The invoice paper (Arial, like the app's doc-paper) ---------- */
  .ivm-paper { container: ivmpaper / inline-size; background: #fff; border-radius: 10px; padding: 16px; font-family: Arial, Helvetica, sans-serif; color: #111827; box-shadow: 0 1px 2px rgba(15,23,42,.06), 0 0 0 1px rgba(15,23,42,.06); }
  .ivm-info { display: grid; grid-template-columns: minmax(0, 1fr) 216px; gap: 14px; align-items: start; margin-bottom: 18px; }
  .ivm-box { border: 1px solid #bfdbfe; border-radius: 4px; background: #fff; }
  .ivm-box-h { padding: 4px 10px; border-radius: 3px 3px 0 0; background: var(--ivm-primary); color: #fff; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .ivm-box-b { padding: 10px; font-size: 12px; }
  .ivm-bill-name { margin-bottom: 4px; font-size: 13px; font-weight: 600; }
  .ivm-bill-line { margin-top: 2px; color: #4b5563; overflow-wrap: anywhere; }
  .ivm-bill-line b { color: #374151; }
  .ivm-taxrow { display: flex; gap: 10px; margin-top: 10px; padding-top: 8px; border-top: 1px dashed #d1d5db; }
  .ivm-taxrow > div { flex: 1; min-width: 0; }
  .ivm-lbl { display: block; margin-bottom: 3px; font-size: 9px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .ivm-pillbox { display: flex; align-items: center; justify-content: space-between; gap: 6px; min-height: 32px; padding: 5px 8px; border: 1px solid #e5e7eb; border-radius: 3px; background: #f3f4f6; font-size: 12px; }
  .ivm-pillbox small { font-size: 9.5px; color: #6b7280; font-weight: 500; text-align: right; }
  .ivm-terms { width: 100%; min-height: 32px; padding: 5px 6px; border: 1px solid #d1d5db; border-radius: 3px; background: #fff; color: #111; font: 12px/1.3 Arial, Helvetica, sans-serif; cursor: pointer; }
  .ivm-terms:hover { border-color: #93c5fd; }
  .ivm-terms:focus { outline: none; border-color: var(--ivm-primary); box-shadow: 0 0 0 3px rgba(0,116,211,.2); }
  .ivm-qn-box { overflow: hidden; margin-bottom: 10px; border: 1px solid #bfdbfe; border-radius: 4px; text-align: center; }
  .ivm-qn-h { padding: 4px 10px; background: var(--ivm-primary); color: #fff; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .ivm-qn-n { padding: 6px 10px; color: var(--ivm-primary); font-size: 16px; font-weight: 700; }
  .ivm-qn-meta { display: grid; grid-template-columns: 78px 1fr; column-gap: 8px; row-gap: 5px; margin: 0; font-size: 11px; color: #374151; }
  .ivm-qn-meta dt { padding-top: 1px; color: #6b7280; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .ivm-qn-meta dd { margin: 0; font-weight: 700; }

  /* Section card (_ibSecHeader, main L18530): band #0074D3 (Pick One, required) / #9333EA (optional) */
  .ivm-sec { margin-bottom: 18px; }
  .ivm-band { display: flex; align-items: center; gap: 7px; min-height: 32px; padding: 5px 10px; border-radius: 4px 4px 0 0; background: var(--ivm-primary); color: #fff; }
  .ivm-band-opt { background: #9333ea; }
  .ivm-band-ic { display: inline-flex; font-size: 13px; line-height: 1; }
  .ivm .ivm-band-t { min-width: 0; margin: 0; color: #fff; font: 700 10.5px/1.3 Arial, Helvetica, sans-serif; text-transform: uppercase; letter-spacing: .06em; overflow-wrap: anywhere; }
  .ivm-secbody { padding: 10px 12px 8px; border: 1px solid #bfdbfe; border-top: 0; border-radius: 0 0 4px 4px; background: #fafbfc; }
  .ivm-tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
  .ivm-tbl th { padding: 7px 8px; border-bottom: 2px solid #e5e7eb; color: #6b7280; font-size: 10.5px; font-weight: 700; text-align: left; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .ivm-th-sub { font-weight: 600; color: #9ca3af; }
  .ivm-tbl td { padding: 9px 8px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
  .ivm-tbl .c { text-align: center; }
