---
// Flagship try-it module: build QT-330 in today's quote builder, the customer approves it on their
// phone, then the office turns the approval into WO-330 + IN-330 (a customer approving online no
// longer creates them — the October app). Markup is server-rendered from the same functions the
// island uses (src/islands/quote-demo.ts), so the page shows the real starting state with no JS.
// Sample data only (src/data/modules/quote.ts ← src/data/sample-data.ts); no network.
import { fmtDate, taxRatePill } from '../../lib/logic';
import { initialState, renderSlots } from '../../islands/quote-demo';
import { quoteSeed as seed } from '../../data/modules/quote';
import { appRailHtml, iconSvg, withAppIcons } from '../../data/modules/app-icons';

const state = initialState(seed);
const slot = renderSlots(seed, state);
const seedJson = JSON.stringify(seed).replace(/</g, '\\u003c');
const sections = seed.quote.sections;
const taxPct = taxRatePill(seed.quote.taxRate, seed.quote.taxExempt);
---
<article class="mod qm" aria-labelledby="qm-title" data-qm>
  <header class="mod-head">
    <div>
      <span class="mod-kicker">Quote a job</span>
      <h3 id="qm-title">Quote it here. They approve it on their phone.</h3>
    </div>
    <p class="mod-task" data-task>Try it: pick a floor, add the stairs, then tap Approve on the phone.</p>
  </header>

  <div class="qm-stage">
    <!-- ================= Builder (the app) ================= -->
    <div class="qm-b">
      <div class="app qm-app" data-privacy="off" data-qm-app role="region" aria-label={`FloorLogic quote builder, quote ${seed.quote.number} (sample data)`}>
        <div class="app-frame qm-frame">
          <div class="app-rail" aria-hidden="true" set:html={appRailHtml('quotes')} />
          <div class="app-main" data-qm-main>
            <div class="app-top qm-top">
              <div class="qm-top-main">
                <div class="qm-top-l">
                  <span class="qm-top-title" set:html={withAppIcons('📝 Quote')} />
                  <span class="qm-top-num">{seed.quote.number}</span>
                  <span class="qm-top-status" data-slot="b-status" set:html={slot['b-status']} />
                </div>
                <div class="qm-top-meta">
                  <span class="qm-cust" title={seed.customer.name}><span class="qm-cust-av" aria-hidden="true">{seed.customer.initials}</span><span class="qm-cust-name">{seed.customer.name}</span></span>
                  <span class="qm-viewed" title="The customer has the quote link open" set:html={withAppIcons('👁 Viewed 1×')} />
                  <span class="qm-act" data-slot="b-action" set:html={slot['b-action']} />
                </div>
              </div>
              <div class="qm-top-r">
                <button type="button" class="a-privbtn" data-privacy-btn aria-pressed="false" aria-label="Privacy mode" title="Privacy Mode — hides company cost, margins, and profit from view (handy when a customer is looking over your shoulder)" set:html={iconSvg('eye')} />
                <div class="qm-gt" data-slot="b-gt" set:html={slot['b-gt']} />
              </div>
            </div>
            <div class="a-tdock"><div class="a-toast qm-btoast" data-btoast aria-hidden="true"></div></div>

            <div class="app-body qm-body" data-qm-body>
              <div class="qm-bannerslot" data-slot="b-banner" set:html={slot['b-banner']} />
              <div class="qm-paper" data-q-builder-paper>
                <div class="qm-info">
                  <div class="qm-box">
                    <div class="qm-box-h">Bill To</div>
                    <div class="qm-box-b">
                      <div class="qm-bill-name">{seed.customer.name}</div>
                      <div class="qm-bill-line"><b>Address:</b> {seed.customer.city}</div>
                      <div class="qm-bill-line"><b>Phone:</b> {seed.customer.phone}</div>
                      <div class="qm-taxrow">
                        <div><div class="qm-lbl">Tax Rate</div><div class="qm-pillbox"><strong>{taxPct}</strong><small>{seed.quote.taxCounty}</small></div></div>
                        <div><div class="qm-lbl">Payment Terms</div><div class="qm-pillbox qm-terms">{seed.quote.paymentTerms}</div></div>
                      </div>
                    </div>
                  </div>
                  <div class="qm-qn">
                    <div class="qm-qn-box"><div class="qm-qn-h">Quote Number</div><div class="qm-qn-n">{seed.quote.number}</div></div>
                    <dl class="qm-qn-meta">
                      <dt>Issued</dt><dd>{fmtDate(seed.quote.createdAt)}</dd>
                      <dt>Valid Until</dt><dd>{fmtDate(seed.quote.expirationDate)}</dd>
                      <dt>Sales Rep</dt><dd>{seed.rep.name}</dd>
                      <dt>Sales Rep 2</dt><dd>— None —</dd>
                    </dl>
                  </div>
                </div>

                {sections.map((s, i) => (
                  <section class={`qm-sec qm-sec-${s.kind}`} aria-labelledby={`qm-sec-t-${i}`} data-slot={`b-sec-${i}`} set:html={slot[`b-sec-${i}`]} />
                ))}

                <div class="qm-bottom">
                  <div class="qm-bottom-l">
                    <div class="qm-ptotwrap" data-slot="b-ptot" set:html={slot['b-ptot']} />
                    <div class="qm-box qm-ap">
                      <div class="qm-box-h" set:html={withAppIcons('✍️ Approval')} />
                      <div class="qm-dp" data-slot="b-dep" set:html={slot['b-dep']} />
                    </div>
                  </div>
                  <aside class="qm-rail" aria-labelledby="qm-rail-h">
                    <div class="qm-rail-h" id="qm-rail-h">Quote Total</div>
                    <div class="qm-rail-b" data-slot="r-rail" set:html={slot['r-rail']} />
                  </aside>
                </div>
              </div>
            </div>
          </div>
        </div>
        <dialog class="a-modal" data-qm-dlg></dialog>
      </div>
    </div>

    <!-- ================= The customer's phone (q.html) ================= -->
    <div class="qm-p">
      <p class="qm-pcap" data-live-chip><span class="qm-livedot" aria-hidden="true"></span>Live link · what {seed.customer.name} see</p>
      <div class="qm-phone" data-phone>
        <div class="qm-screen" data-phone-screen>
          <div class="qm-island" aria-hidden="true"></div>
          <div class="qm-status" aria-hidden="true">
            <span>9:41</span>
            <span class="qm-status-ic">
              <svg viewBox="0 0 18 12" width="18" height="12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5.5" width="3" height="6.5" rx="1"/><rect x="10" y="3" width="3" height="9" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1"/></svg>
              <svg viewBox="0 0 24 24" width="16" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.86a10 10 0 0 1 14 0"/><path d="M8.5 16.43a5 5 0 0 1 7 0"/></svg>
              <svg viewBox="0 0 27 13" width="25" height="12"><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" fill="none" stroke="currentColor" stroke-opacity=".4"/><rect x="2.5" y="2.5" width="19" height="8" rx="2" fill="currentColor"/><path d="M25 4.5v4a2 2 0 0 0 0-4z" fill="currentColor" fill-opacity=".45"/></svg>
            </span>
          </div>
          <div class="qm-pscroll" data-phone-scroll role="region" aria-label={`The customer's phone: live quote ${seed.quote.number}`} tabindex="0">
            <div class="qm-q">
              <div class="qm-q-wrap">
                <div class="qm-q-paper" data-q-paper>
                  <div data-slot="p-stamp" set:html={slot['p-stamp']} />
                  <div class="qm-q-header">
                    <div class="qm-q-top">
                      <div class="qm-q-logo">
                        <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true"><rect x="18.2" y="25" width="3.6" height="9" rx="1.4" fill="#7a5a3a"/><path d="M20 3.5c5.4 4.8 10.2 9.6 10.2 15.3 0 4-2.9 6.7-6.6 6.7h-7.2c-3.7 0-6.6-2.7-6.6-6.7C9.8 13.1 14.6 8.3 20 3.5z" fill="#3f6b4f"/><path d="M20 12.2c3.9 3.4 7 6.6 7 10.3 0 2.6-1.9 4.3-4.3 4.3h-5.4c-2.4 0-4.3-1.7-4.3-4.3 0-3.7 3.1-6.9 7-10.3z" fill="#5a8a68"/><path d="M5 36.5h30" stroke="#c4a87c" stroke-width="2.2" stroke-linecap="round"/></svg>
                        <span class="qm-q-logo-t"><b>Pinyon</b><small>Flooring Co.</small></span>
                      </div>
                      <div class="qm-q-topr">
                        <div class="qm-q-qbox"><div class="qm-q-qbox-h">QUOTE NUMBER</div><div class="qm-q-qbox-n">{seed.quote.number}</div></div>
                        <div class="qm-q-dates">
                          <div class="qm-q-rrow"><span class="qm-q-rlbl">ISSUED</span><span class="qm-q-rval">{fmtDate(seed.quote.createdAt)}</span></div>
                          <div class="qm-q-rrow"><span class="qm-q-rlbl">VALID UNTIL</span><span class="qm-q-rval">{fmtDate(seed.quote.expirationDate)}</span></div>
                        </div>
                      </div>
                    </div>
                    <div class="qm-q-meta">
                      <dl>
                        <dt>ADDRESS</dt><dd>{seed.shop.address}<br />{seed.shop.city}</dd>
                        <dt>PHONE</dt><dd>{seed.shop.phone}</dd>
                        <dt>EMAIL</dt><dd>{seed.shop.email}</dd>
                      </dl>
                      <div class="qm-q-rep"><div class="qm-q-rep-l">SALES REP</div><div class="qm-q-rep-n">{seed.rep.name}</div><span class="qm-q-rep-e">{seed.rep.email}</span></div>
                    </div>
                  </div>
                  <div class="qm-q-bs">
                    <div class="qm-q-box">
                      <div class="qm-q-box-h">BILL TO</div>
                      <dl>
                        <dt>NAME</dt><dd>{seed.customer.name}</dd>
                        <dt>ADDRESS</dt><dd>{seed.customer.city}</dd>
                        <dt>PHONE</dt><dd>{seed.customer.phone}</dd>
                        <dt>EMAIL</dt><dd>{seed.customer.email}</dd>
                      </dl>
                    </div>
                    <div class="qm-q-box">
                      <div class="qm-q-box-h">SITE DETAILS</div>
                      <dl>
                        <dt>CONTACT</dt><dd>{seed.customer.name}</dd>
                        <dt>ADDRESS</dt><dd>{seed.customer.city}</dd>
                        <dt>PHONE</dt><dd>{seed.customer.phone}</dd>
                      </dl>
                    </div>
                  </div>
                  {sections.map((_, i) => <div data-slot={`p-sec-${i}`} set:html={slot[`p-sec-${i}`]} />)}
                  <div class="qm-q-bot">
                    <div class="qm-q-pterms"><span class="qm-q-lbl">PAYMENT TERMS</span>{seed.quote.paymentTerms}</div>
                    <div data-slot="p-totals" set:html={slot['p-totals']} />
                  </div>
                  <div class="qm-q-aph">APPROVAL</div>
                  <div data-slot="p-approval" set:html={slot['p-approval']} />
                  <div class="qm-q-footer">{seed.shop.name} | {seed.shop.address}, {seed.shop.city} | {seed.shop.phone}<em>Thank you for choosing {seed.shop.name}!</em></div>
                </div>
              </div>
            </div>
          </div>
          <div class="qm-ptoast" data-ptoast aria-hidden="true"></div>
          <div class="qm-home" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>

  <p class="mod-foot">Same math as the app: whole cartons, carpet by the yard, Washoe County tax on materials. The builder’s Grand Total counts the required sections and the floor that’s picked; an optional section counts once the customer adds it. Sample data — nothing is saved or sent. <button type="button" class="qm-linkbtn" data-reset>Reset</button></p>
  <p class="sr-only" aria-live="polite" data-live></p>
  <script type="application/json" data-qm-seed set:html={seedJson}></script>
</article>

<script>
  import { whenNear } from '../../lib/when-near';
  whenNear('#panel-quote, .qm', () => import('../../islands/quote-demo').then((m) => m.initQuoteDemo()));
</script>

<style is:global>
  /* ================= QuoteModule (.qm-) — DOM is patched by script, so global + prefixed ================= */
  .qm { --qm-primary: #0074d3; --qm-green: #047857; }
  .qm .mod-head h3 { text-wrap: balance; }
  .qm-stage { display: grid; gap: 28px; align-items: start; }
  @media (min-width: 1100px) {
    .qm-stage { grid-template-columns: minmax(0, 1fr) minmax(340px, 392px); gap: 32px; }
    .qm-p { position: sticky; top: var(--app-stick); }
  }
  .qm-linkbtn { background: none; border: 0; padding: 0 2px; font: inherit; font-weight: 700; color: var(--blue-ink); text-decoration: underline; text-underline-offset: .18em; cursor: pointer; }
  .qm-linkbtn:hover { color: var(--navy-900); }
  .qm .mod-foot { line-height: 1.55; max-width: 92ch; }

  /* ---------- Builder frame + header (renderQuoteBuilder header, main L12782) ---------- */
  .qm-b { position: relative; min-width: 0; }
  /* Two steady rows (the app's header also stacks the title over its tools): title, then the
     customer + what the office can do next; privacy + Grand Total stay centred on the right. */
  .qm .app-top.qm-top { position: sticky; top: var(--app-stick); z-index: 4; min-height: 60px; padding: 9px 14px; gap: 12px; box-shadow: 0 8px 18px -16px rgba(15,23,42,.45); }
  .qm-top-main { display: grid; gap: 7px; min-width: 0; flex: 1 1 auto; }
  .qm-top-l { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .qm-top-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 8px; min-width: 0; }
  .qm-top-title { display: inline-flex; align-items: center; gap: 5px; font: 800 19px/1.1 var(--font-app); color: var(--qm-primary); letter-spacing: -.01em; white-space: nowrap; }
  .qm-top-num { font: 700 13.5px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: #6b7280; letter-spacing: .04em; }
  .qm-top-status .a-pill { font-size: 10px; }
  .qm-cust { display: inline-flex; align-items: center; gap: 8px; min-width: 0; max-width: 100%; padding: 3px 11px 3px 3px; border: 1px solid var(--app-border); border-radius: 999px; background: #fff; }
  .qm-cust-av { flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, #2563eb, #1e40af); color: #fff; font: 700 11px/1 var(--font-app); letter-spacing: .02em; }
  .qm-cust-name { font: 600 13px/1.25 var(--font-app); color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .qm-viewed { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 10px; background: #dbeafe; color: #1e40af; font: 700 10px/1.6 var(--font-app); text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .qm-act:empty { display: none; }
  .qm-convert { min-height: 32px; }
  .qm-top-r { flex: none; margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .qm-gt { display: inline-flex; flex-direction: column; align-items: flex-end; padding: 5px 12px 6px; border: 1px solid #bfdbfe; border-radius: 12px; background: linear-gradient(135deg, #eff6ff, #f0f9ff); line-height: 1.1; }
  .qm-gt-cap { font: 700 9.5px/1.2 var(--font-app); text-transform: uppercase; letter-spacing: .06em; color: #1e3a8a; }
  .qm-gt-val { font: 700 19px/1.15 var(--font-app); color: var(--qm-primary); margin-top: 1px; }
  .qm .qm-body { padding: 14px; background: var(--app-bg); }
  /* Toasts dock just under the sticky header (its height is measured by the island). */
  .qm .a-tdock { top: calc(var(--app-stick) + var(--qm-head, 64px)); }
  .qm .qm-btoast { top: 10px; }

  /* ---------- The quote paper (Arial, like the app's doc-paper) ---------- */
  .qm-paper { container: qmpaper / inline-size; background: #fff; border-radius: 10px; padding: 16px; font-family: Arial, Helvetica, sans-serif; color: #111827; box-shadow: 0 1px 2px rgba(15,23,42,.06), 0 0 0 1px rgba(15,23,42,.06); }
  .qm-info { display: grid; grid-template-columns: minmax(0, 1fr) 216px; gap: 14px; align-items: start; margin-bottom: 18px; }
  .qm-box { border: 1px solid #bfdbfe; border-radius: 4px; background: #fff; }
  .qm-box-h { display: flex; align-items: center; gap: 5px; background: var(--qm-primary); color: #fff; padding: 4px 10px; border-radius: 3px 3px 0 0; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .qm-box-b { padding: 10px; font-size: 12px; }
  .qm-bill-name { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
  .qm-bill-line { margin-top: 2px; color: #4b5563; }
  .qm-bill-line b { color: #374151; }
  .qm-taxrow { display: flex; gap: 10px; margin-top: 10px; padding-top: 8px; border-top: 1px dashed #d1d5db; }
  .qm-taxrow > div { flex: 1; min-width: 0; }
  .qm-lbl { margin-bottom: 3px; font-size: 9px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .qm-pillbox { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 5px 8px; border: 1px solid #e5e7eb; border-radius: 3px; background: #f3f4f6; font-size: 12px; }
  .qm-pillbox small { font-size: 9.5px; color: #6b7280; font-weight: 500; text-align: right; }
  .qm-terms { background: #fff; color: #374151; line-height: 1.3; }
  .qm-qn-box { overflow: hidden; margin-bottom: 10px; border: 1px solid #bfdbfe; border-radius: 4px; text-align: center; }
  .qm-qn-h { background: var(--qm-primary); color: #fff; padding: 4px 10px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .qm-qn-n { padding: 6px 10px; font-size: 16px; font-weight: 700; color: var(--qm-primary); }
  .qm-qn-meta { display: grid; grid-template-columns: 78px 1fr; column-gap: 8px; row-gap: 5px; margin: 0; font-size: 11px; color: #374151; }
  .qm-qn-meta dt { padding-top: 1px; font-size: 9px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .qm-qn-meta dd { margin: 0; font-weight: 700; }

  /* Section card (renderSec, main L12849): band #0074D3 (required, Pick One) / #9333EA (optional) */
  .qm-sec { margin-bottom: 18px; }
  .qm-band { display: flex; align-items: center; gap: 6px; min-height: 34px; padding: 5px 10px; border-radius: 4px 4px 0 0; background: var(--qm-primary); color: #fff; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .qm-band-optional { background: #9333ea; }
  .qm-band-drag { display: inline-flex; padding: 2px 3px; color: rgba(255,255,255,.75); font-size: 14px; line-height: 1; }
  .qm-band-ic { display: inline-flex; font-size: 13px; line-height: 1; }
  .qm .qm-band-t { flex: 0 1 auto; min-width: 0; max-width: min(100%, 300px); margin: 0; padding: 3px 8px; border: 1px solid #cbd5e1; border-radius: 3px; background: #fff; color: #111; font: 400 11.5px/1.3 Arial, Helvetica, sans-serif; letter-spacing: normal; text-transform: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .qm-band-lock { margin-left: auto; display: grid; place-items: center; width: 26px; height: 24px; border: 1.5px solid rgba(255,255,255,.55); border-radius: 6px; background: rgba(255,255,255,.18); font-size: 13px; }
  .qm-secbody { padding: 12px; border: 1px solid #bfdbfe; border-top: 0; border-radius: 0 0 4px 4px; background: #fafbfc; }

  /* 📐 Job Area bar (main L12852): info colours, SqFt + SqYd boxes, each with Apply */
  .qm-area { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 8px; margin-bottom: 10px; padding: 6px 10px; border: 1px solid #bfdbfe; border-radius: 3px; background: #eff6ff; font-size: 11.5px; }
  .qm-area-l { display: inline-flex; align-items: center; gap: 4px; color: #1d4ed8; font-weight: 700; }
  .qm-area input { width: 76px; min-height: 30px; padding: 3px 6px; border: 1px solid #93c5fd; border-radius: 3px; background: #fff; color: #111; font: 13px/1.2 Arial, Helvetica, sans-serif; text-align: right; }
  .qm-area input:focus { outline: none; border-color: var(--qm-primary); box-shadow: 0 0 0 3px rgba(0,116,211,.2); }
  .qm-area-u { color: #1d4ed8; }
  .qm-area button { min-height: 30px; padding: 3px 12px; border: 0; border-radius: 3px; background: #1d4ed8; color: #fff; font: 700 12px/1 Arial, Helvetica, sans-serif; cursor: pointer; }
  .qm-area button:hover:not(:disabled) { background: #1e40af; }
  .qm-area input:disabled, .qm-area button:disabled { opacity: .55; cursor: not-allowed; }
  .qm-area-sep { width: 1px; height: 18px; background: #bfdbfe; }
  .qm-area-g { display: inline-flex; align-items: center; gap: 6px; }

  .qm-mcban { display: flex; align-items: baseline; flex-wrap: wrap; gap: 3px 8px; margin: 0 0 10px; padding: 8px 12px; border: 1px solid #bae6fd; border-radius: 6px; background: #f0f9ff; color: #0c4a6e; font-size: 12px; line-height: 1.4; }
  .qm-mcban-l { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .qm-mcban-p { font-weight: 700; }
  .qm-mcban-n { font-size: 11px; }

  /* Line-item table (qb-line-table, main L13070) */
  .qm-tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
  .qm-tbl th { padding: 8px; border-bottom: 2px solid #e5e7eb; color: #6b7280; font-size: 10.5px; font-weight: 700; text-align: left; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .qm-th-sub { font-weight: 600; color: #9ca3af; }
  .qm-tbl td { padding: 10px 8px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
  .qm-tbl .qm-c-pick { width: 40px; padding-left: 4px; padding-right: 4px; text-align: center; }
  .qm-tbl th.qm-c-qty, .qm-tbl td.qm-c-qty { text-align: center; }
  .qm-tbl th.qm-c-price, .qm-tbl th.qm-c-total, .qm-tbl td.qm-c-price, .qm-tbl td.qm-c-total { text-align: right; }
  .qm-tbl .qm-c-desc { width: 17%; }
  .qm-tbl td.qm-c-desc { color: #374151; font-size: 12.5px; }
  .qm-ph { color: #9ca3af; }
  .qm-radio { width: 18px; height: 18px; margin: 7px 0 0; accent-color: #10b981; cursor: pointer; }
  .qm-radio:disabled { cursor: not-allowed; }
  .qm-namewrap { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 6px; }
  .qm-name { font-size: 13px; font-weight: 500; line-height: 1.35; }
  label.qm-name { cursor: pointer; }
  .qm-name-mat { color: var(--qm-primary); }
  .qm-name-lab { color: #9333ea; }
  .qm-qtywrap { display: inline-flex; align-items: center; gap: 4px; justify-content: center; }
  .qm-chip { width: 76px; height: 32px; padding: 0 8px; border: 1px solid #e5e7eb; border-radius: 6px; background: #f3f4f6; color: #111827; font: 400 13px/1 Arial, Helvetica, sans-serif; text-align: right; font-variant-numeric: tabular-nums; -moz-appearance: textfield; appearance: textfield; }
  .qm-chip::-webkit-outer-spin-button, .qm-chip::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .qm-chip:hover:not(:disabled) { border-color: #cbd5e1; }
  .qm-chip:focus { outline: none; border-color: var(--qm-primary); background: #fff; box-shadow: 0 0 0 3px rgba(37,99,235,.15); }
  .qm-chip:disabled { color: #4b5563; cursor: not-allowed; }
  .qm-chip-money { width: 66px; color: var(--qm-green); font-weight: 500; }
  .qm-uom { min-width: 34px; color: #6b7280; font-size: 11px; font-weight: 500; text-align: left; }
  .qm-moneywrap { display: inline-flex; align-items: center; gap: 3px; justify-content: flex-end; }
  .qm-dollar { color: var(--qm-green); font-size: 12px; }
  .qm-total { display: inline-flex; align-items: center; gap: 3px; height: 32px; color: var(--qm-green); font-weight: 700; white-space: nowrap; }
  .qm-cost { margin-top: 4px; color: #6b7280; font-size: 12px; text-align: right; white-space: nowrap; text-decoration: underline dotted; text-underline-offset: 2px; }
  .qm-hint { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 2px 5px; margin-top: 5px; font-size: 12px; line-height: 1.4; }
  .qm-hint b { display: inline-flex; align-items: center; gap: 3px; color: var(--qm-primary); font-weight: 700; white-space: nowrap; }
  .qm-hint span { color: #6b7280; white-space: nowrap; }
  .qm-hint-roll { flex-direction: column; align-items: center; gap: 0; }
  .qm-rollbtn { display: inline-flex; align-items: center; gap: 3px; padding: 0; border: 0; background: none; color: var(--qm-primary); font: 700 12px/1.35 Arial, Helvetica, sans-serif; cursor: pointer; white-space: nowrap; }
  .qm-rollbtn:hover:not(:disabled) { text-decoration: underline; }
  .qm-rollbtn:disabled { cursor: default; }
  .qm-rollbtn-warn { color: #dc2626; }
  .qm-rollw { color: #6b7280; font-size: 11px; }
  .qm-row { transition: background-color .2s; }
  /* After approval (qb-mc-row): the customer's pick washed green, the rest struck through */
  .qm-row.qm-mc-chosen { background: linear-gradient(90deg, rgba(16,185,129,.10), rgba(16,185,129,.02)); box-shadow: inset 4px 0 0 #10b981; }
  .qm-row.qm-mc-chosen .qm-name { color: #065f46; font-weight: 700; }
  .qm-row.qm-mc-unchosen { background: #f8fafc; opacity: .62; }
  .qm-row.qm-mc-unchosen .qm-name, .qm-row.qm-mc-unchosen .qm-total { color: #64748b; text-decoration: line-through; }
  .qm-mcbadge { display: inline-flex; align-items: center; gap: 3px; padding: 1px 6px; border-radius: 9px; font: 700 9px/1.5 Arial, Helvetica, sans-serif; letter-spacing: .05em; text-transform: uppercase; white-space: nowrap; }
  .qm-mcbadge.is-chosen { background: #d1fae5; color: #064e3b; border: 1px solid #6ee7b7; }
  .qm-mcbadge.is-not { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }

  /* "+ Add line item" (_aliBtnHtml, main L14058) and its menu */
  .qm-ali { position: relative; padding: 10px 0 2px; }
  .qm-ali-btn { padding: 6px 14px; border: 1px dashed #93c5fd; border-radius: 6px; background: #fff; color: var(--qm-primary); font: 600 13px/1.3 var(--font-app); cursor: pointer; }
  .qm-ali-btn:hover, .qm-ali-btn[aria-expanded='true'] { background: #eff6ff; border-style: solid; }
  .qm-menu { position: absolute; left: 0; top: calc(100% + 4px); z-index: 6; display: grid; min-width: 190px; padding: 5px; border: 1px solid var(--app-border); border-radius: 8px; background: #fff; box-shadow: 0 12px 28px -8px rgba(15,23,42,.28); font-family: var(--font-app); }
  .qm-menu button { padding: 8px 10px; border: 0; border-radius: 6px; background: none; color: var(--app-text); font: 500 13px/1.3 var(--font-app); text-align: left; cursor: pointer; }
  .qm-menu button:hover, .qm-menu button:focus { background: #eff6ff; color: var(--qm-primary); outline: none; }
  .qm-menu button:focus-visible { box-shadow: inset 0 0 0 2px var(--qm-primary); }

  .qm-sectot { margin-top: 10px; font-size: 12px; }
  .qm-sectot-h { padding: 0 8px 4px; color: #6b7280; font-size: 10px; font-weight: 700; text-align: right; text-transform: uppercase; letter-spacing: .06em; }
  .qm-sectot-r { display: flex; justify-content: flex-end; align-items: baseline; gap: 16px; padding: 4px 8px; color: #6b7280; }
  .qm-sectot-r span:last-child { min-width: 96px; color: #374151; font-weight: 600; text-align: right; }
  .qm-sectot-sub { border-top: 1px solid #e5e7eb; color: #374151; font-size: 13px; font-weight: 700; }
  .qm-sectot-sub span:last-child { color: #111; font-weight: 700; }

  /* Paper bottom: Optional Add-Ons + TOTAL (WITH DEFAULTS), Approval / Down Payment, the QUOTE TOTAL card */
  .qm-bottom { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 264px); gap: 16px; align-items: start; }
  .qm-bottom-l { display: grid; gap: 14px; min-width: 0; }
  .qm-ptot { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .qm-ptot-oh { padding: 6px 12px 4px; color: #9333ea; font-size: 10px; font-weight: 700; text-align: right; text-transform: uppercase; letter-spacing: .06em; }
  .qm-ptot-opt td { padding: 4px 12px; color: #6b21a8; font-weight: 600; text-align: right; }
  .qm-ptot-opt td:last-child { width: 120px; font-weight: 700; }
  .qm-ptot-total td { padding: 9px 12px; border-top: 2px solid var(--qm-primary); background: #e8f0fe; color: var(--qm-primary); text-align: right; }
  .qm-ptot-total td:first-child { border-radius: 6px 0 0 6px; font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; }
  .qm-ptot-total td:last-child { border-radius: 0 6px 6px 0; font-size: 16px; font-weight: 800; white-space: nowrap; }
  .qm-dp { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; padding: 12px; color: #4b5563; font-size: 12px; }
  .qm-dp-l { color: #374151; font-weight: 600; }
  .qm-dp-in { width: 60px; min-height: 30px; padding: 3px 6px; border: 1px solid #e5e7eb; border-radius: 3px; background: #fff; color: #111; font: 13px/1.2 Arial, Helvetica, sans-serif; text-align: center; }
  .qm-dp-in:focus { outline: none; border-color: var(--qm-primary); box-shadow: 0 0 0 3px rgba(0,116,211,.2); }
  .qm-dp-in:disabled { background: #f4f6fa; cursor: not-allowed; }
  .qm-dp-amt { display: inline-flex; align-items: center; gap: 4px; color: #6b7280; font-size: 11px; }
  /* QUOTE TOTAL card (CSS main L1504-1526): 248px, #fff, #BFDBFE, radius 12 */
  .qm-rail { padding: 12px 0; border: 1px solid #bfdbfe; border-radius: 12px; background: #fff; font-family: var(--font-app); box-shadow: 0 4px 16px rgba(37,99,235,.10), 0 1px 3px rgba(0,0,0,.04); }
  .qm-rail-h { padding: 0 16px 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .qm-rail-b { padding-top: 6px; }
  .qm-trow { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 5px 16px; font-size: 12px; }
  .qm-tl { display: inline-flex; align-items: center; gap: 6px; color: #334155; }
  .qm-tl-mat { color: #b45309; }
  .qm-tl-lab { color: var(--qm-green); }
  .qm-tv { color: #0f172a; font-weight: 700; }
  .qm-trow-hl { margin: 6px 8px; padding: 8px 10px; border: 1px solid #bfdbfe; border-radius: 8px; background: linear-gradient(135deg, #eff6ff, #dbeafe); }
  .qm-trow-hl .qm-tl { color: #1e3a8a; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .qm-trow-hl .qm-tv { color: var(--qm-primary); font-size: 16px; }
  .qm-tv-m { color: var(--qm-primary); }
  .qm-tv-m.is-neg { color: #dc2626; }
  .qm-tsep { margin: 6px 12px; border: 0; border-top: 1px solid #e5e7eb; }

  /* Locked banner (main L12794) + the documents the office made */
  .qm-bannerslot:empty { display: none; }
  .qm-bannerslot { display: grid; gap: 12px; margin-bottom: 14px; }
  .qm-lock { display: flex; align-items: flex-start; gap: 10px; padding: 10px 14px; border: 1px solid #f59e0b; border-left-width: 4px; border-radius: 6px; background: #fef3c7; color: #78350f; font-size: 12.5px; line-height: 1.5; }
  .qm-lock-ic { font-size: 18px; line-height: 1.2; }
  .qm-lock-t { display: block; color: #7c2d12; font-size: 13.5px; font-weight: 700; }
  .qm-docs { display: grid; gap: 10px; outline: none; }
  .qm-docs:focus-visible { outline: 3px solid var(--dot); outline-offset: 4px; border-radius: 8px; }
  .qm .qm-docs-h h4 { color: #6b7280; font: 700 10.5px/1.2 var(--font-app); text-transform: uppercase; letter-spacing: .08em; }
  .qm-docs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; }
  .qm-doc { padding: 12px 14px; border-left: 4px solid #7c3aed; border-radius: 10px; background: #fff; font-family: var(--font-app); box-shadow: 0 18px 36px -20px rgba(2,49,91,.45), 0 0 0 1px rgba(2,49,91,.09); }
  .qm-doc-in { border-left-color: #4b5563; }
  .qm-doc-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .qm-doc-num { display: inline-flex; align-items: center; gap: 6px; color: #111827; font: 700 15px/1 var(--font-app); letter-spacing: .01em; }
  .qm-doc-line { margin-top: 8px; color: #374151; font-size: 12.5px; }
  .qm-doc-sub { margin-top: 4px; color: #6b7280; font-size: 12px; line-height: 1.4; }
  .qm-doc-due { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-top: 8px; padding: 6px 10px; border: 1px solid #bfdbfe; border-radius: 8px; background: #f8fbff; color: #005ba8; font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .qm-doc-due b { color: var(--qm-primary); font-size: 16px; letter-spacing: 0; text-transform: none; }
  .qm-docs-note { color: #4b5563; font: 500 12px/1.45 var(--font-app); }

  /* Dialog bits (Roll Dimensions, Add line item, the convert confirm) */
  .qm-rd-intro, .qm-cv-p { margin: 0; }
  .qm-rd { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .qm-rd fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .qm-rd legend { margin-bottom: 6px; padding: 0; color: #6b7280; font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .qm-rd-in { display: flex; align-items: center; gap: 6px; font-weight: 600; }
  .qm-rd-in input { width: 70px; min-height: 38px; padding: 6px; border: 1px solid #d1d5db; border-radius: 8px; font: 14px/1.2 var(--font-app); text-align: center; }
  .qm-rd-in input:focus { outline: none; border-color: var(--qm-primary); box-shadow: 0 0 0 3px rgba(0,116,211,.2); }
  .qm-rd-note { color: #92400e; font-size: 12px; line-height: 1.5; }
  .qm-rd-prev { padding: 10px 12px; border: 1px solid #bfdbfe; border-radius: 4px; background: #eff6ff; color: #1d4ed8; font-size: 13px; font-weight: 600; text-align: center; }
  .qm-rd-clear { color: #b91c1c; border-color: #fca5a5; }
  .qm-ali-search { width: 100%; min-height: 40px; font-size: 14px; }
  .qm-ali-list { max-height: min(46vh, 340px); overflow-y: auto; border: 1px solid var(--app-border); border-radius: 8px; }
  .qm-ali-opt { padding: 8px 12px; border-bottom: 1px solid #f1f2f4; cursor: pointer; }
  .qm-ali-opt.is-active, .qm-ali-opt:hover { background: #eff6ff; }
  .qm-ali-opt.is-active { box-shadow: inset 3px 0 0 var(--qm-primary); }
  .qm-ali-main { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: 13px; font-weight: 600; line-height: 1.35; color: var(--app-text); }
  .qm-ali-sub { margin-top: 2px; color: #6b7280; font-size: 11.5px; line-height: 1.4; }
  .qm-ali-custom .qm-ali-main { color: var(--qm-primary); }
  .qm-ali-group { padding: 6px 12px 4px; background: #f8fafc; color: #6b7280; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .qm-ali-badge { padding: 1px 7px; border-radius: 9px; color: #3b2f2a; font-size: 10px; font-weight: 700; }
  .qm-ali-badge.is-lab { background: #fcd9b6; }
  .qm-ali-badge.is-prod { background: #ead1dc; }
  .qm-ali-empty { padding: 12px; color: #6b7280; font-size: 12.5px; }
  .qm-ali-hint { margin: 0; color: #4b5563; font-size: 13px; }
  .qm-ali-cform { display: flex; gap: 8px; }
  .qm-ali-cform .a-input { flex: 1; min-width: 0; min-height: 40px; font-size: 14px; }
  .qm-ali-cform .a-input.is-need { border-color: #dc2626; box-shadow: 0 0 0 3px rgba(220,38,38,.15); }
  .qm-ali-back { justify-self: start; }

  /* Flash a value or row when something changed it */
  @keyframes qm-flash { from { background-color: rgba(0,116,211,.18); } to { background-color: transparent; } }
  @keyframes qm-ring { from { box-shadow: 0 0 0 4px rgba(0,116,211,.35); } to { box-shadow: 0 0 0 10px rgba(0,116,211,0); } }
  .qm tr.qm-flash > td { animation: qm-flash 1s ease-out; }
  .qm .qm-gt.qm-flash, .qm .qm-convert.qm-flash { animation: qm-ring .8s ease-out; }
  .qm .qm-q-grand.qm-flash { animation: qm-flash 1s ease-out; }

  /* Builder narrower than a desktop table: each line becomes a stacked card */
  @container qmpaper (max-width: 600px) {
    .qm-info { grid-template-columns: minmax(0, 1fr); }
    .qm-bottom { grid-template-columns: minmax(0, 1fr); }
    .qm-tbl thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .qm-tbl, .qm-tbl tbody { display: block; }
    .qm-tbl tr.qm-row { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, .9fr); grid-template-areas: 'item item item' 'qty price total'; gap: 8px 10px; padding: 12px 4px; border-bottom: 1px solid #e5e7eb; }
    .qm-tbl tr.qm-row-mc { grid-template-columns: 26px minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, .9fr); grid-template-areas: 'pick item item item' 'pick qty price total'; }
    .qm-tbl td { display: block; min-width: 0; padding: 0; border: 0; }
    .qm-tbl td.qm-c-desc { display: none; }
    .qm-tbl td[data-label]::before { content: attr(data-label); display: block; margin-bottom: 3px; color: #6b7280; font: 700 9.5px/1.2 Arial, Helvetica, sans-serif; text-transform: uppercase; letter-spacing: .06em; text-align: left; }
    .qm-tbl .qm-c-pick { grid-area: pick; width: auto; padding: 0; text-align: left; }
    .qm-tbl .qm-radio { margin-top: 1px; }
    .qm-tbl .qm-c-item { grid-area: item; }
    .qm-tbl td.qm-c-qty { grid-area: qty; text-align: left; }
    .qm-tbl td.qm-c-price { grid-area: price; text-align: left; }
    .qm-tbl td.qm-c-total { grid-area: total; text-align: right; }
    .qm-tbl td.qm-c-total::before { text-align: right; }
    .qm-qtywrap, .qm-moneywrap { justify-content: flex-start; }
    .qm-chip { width: 72px; }
    .qm-chip-money { width: 62px; }
    .qm-hint { justify-content: flex-start; }
    .qm-hint-roll { align-items: flex-start; }
    .qm-cost { text-align: left; }
    .qm-tbl .qm-name { font-size: 13.5px; }
    .qm-sectot-r span:last-child { min-width: 84px; }
    .qm-area-sep { display: none; }
    .qm-area { gap: 8px 12px; }
    .qm-ptot-total td:first-child { font-size: 12.5px; }
    .qm-ptot-total td:last-child { font-size: 15px; }
  }
  @container qmpaper (max-width: 400px) {
    .qm-taxrow { flex-direction: column; }
    .qm-tbl tr.qm-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: 'item item' 'qty price' 'total total'; }
    .qm-tbl tr.qm-row-mc { grid-template-columns: 26px minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: 'pick item item' 'pick qty price' 'pick total total'; }
    .qm-tbl td.qm-c-total { display: flex; align-items: baseline; justify-content: space-between; text-align: left; }
    .qm-tbl td.qm-c-total::before { margin: 0; }
    .qm-total { height: auto; }
  }
  @media (max-width: 560px) {
    .qm .app-frame { grid-template-columns: minmax(0, 1fr); }
    .qm .app-rail { display: none; }
    .qm .qm-body { padding: 10px; }
    .qm-paper { padding: 12px; }
    .qm-secbody { padding: 10px; }
    .qm-cust, .qm-viewed { display: none; }
    .qm-top-meta:not(:has(.qm-convert)) { display: none; }
    .qm .app-top.qm-top { flex-wrap: wrap; gap: 8px; min-height: 54px; padding: 7px 8px 7px 12px; }
    .qm-top-main { display: contents; }
    .qm-top-l { gap: 6px; }
    .qm-top-title { font-size: 16px; }
    .qm-top-num { font-size: 11.5px; }
    .qm-top-r { gap: 6px; }
    .qm .a-privbtn { width: 34px; height: 34px; }
    .qm-gt { padding: 4px 9px 5px; border-radius: 10px; }
    .qm-gt-cap { font-size: 8.5px; }
    .qm-gt-val { font-size: 15.5px; }
    .qm-top-meta { order: 5; flex-basis: 100%; }
    .qm-act { flex: 1; }
    .qm-convert { width: 100%; min-height: 38px; font-size: 13px; }
    .qm .qm-btoast { right: 10px; max-width: calc(100% - 20px); }
  }
  /* Desktop: keep the module about one screen tall — the builder scrolls inside its window, like the app. */
  @media (min-width: 1100px) { .qm .qm-body { max-height: min(74vh, 720px); overflow-y: auto; scrollbar-width: thin; } }

  /* ---------- Phone (customer's live quote, q.html at phone width) ---------- */
  .qm-p { width: 100%; min-width: 0; max-width: 392px; margin-inline: auto; }
  .qm-pcap { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0 0 12px; color: var(--navy-900); font: 700 13.5px/1.3 var(--font-body); text-align: center; }
  .qm-livedot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,.2); }
  @keyframes qm-ping { from { box-shadow: 0 0 0 0 rgba(16,185,129,.6); } to { box-shadow: 0 0 0 11px rgba(16,185,129,0); } }
  .qm-pcap.is-sync .qm-livedot { animation: qm-ping .75s ease-out; }
  .qm-phone { container: qmphone / inline-size; position: relative; width: min(100%, 380px); margin-inline: auto; padding: 11px; border-radius: 54px; background: linear-gradient(150deg, #2c3441 0%, #121821 46%, #222a36 100%); box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.14), inset 0 0 0 5px #0b0f15, 0 2px 4px rgba(2,49,91,.12), 0 44px 70px -30px rgba(2,49,91,.6); }
  .qm-phone::before, .qm-phone::after { content: ''; position: absolute; width: 3px; border-radius: 2px; background: #2c3441; }
  .qm-phone::before { left: -3px; top: 132px; height: 52px; box-shadow: 0 70px 0 #2c3441; }
